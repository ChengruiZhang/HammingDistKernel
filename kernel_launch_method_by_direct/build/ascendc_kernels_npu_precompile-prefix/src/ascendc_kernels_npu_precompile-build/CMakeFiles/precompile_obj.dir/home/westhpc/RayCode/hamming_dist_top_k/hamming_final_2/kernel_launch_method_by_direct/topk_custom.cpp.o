        kIter_ = IsBasicK(MM_CFG) ? 1 : Ceil(singleShape, baseK);

                                                                                                  ;
        if (kIter_ > stepKa) {
            if constexpr (!DoMatmulSpecialMDL(MM_CFG)) {

                                                                                                            ;
            }
        }
        if (kIter_ > stepKb) {
            if constexpr (!DoMatmulSpecialMDL(MM_CFG)) {

                                                                                                        ;
            }
        }
        if constexpr (NoTailK(MM_CFG)) {
            tailK_ = baseK;
        } else {
