                                                                                                          ;
                }
            }
        }

        if constexpr (NoTailK(MM_CFG)) {
            tailK_ = cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
        } else {
            tailK_ = singleShape % cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
            if (tailK_ == 0) {
                tailK_ = cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
            }
        }
        if constexpr (IsBasic(MM_CFG)) {
            if constexpr (ToMatmulConfig(MM_CFG).enableSetTail) {
