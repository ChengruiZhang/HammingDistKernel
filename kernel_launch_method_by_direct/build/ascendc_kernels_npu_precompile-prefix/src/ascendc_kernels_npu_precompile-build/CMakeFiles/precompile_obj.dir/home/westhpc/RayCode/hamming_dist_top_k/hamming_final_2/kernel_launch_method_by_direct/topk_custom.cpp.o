        if (gCol % c0Size_ != 0 || srcGap >= (65535)) {
            int64_t oriSrcOffset = srcOffset;
            int oriDstOffset = dstOffset;

            for (int i = 0; i < calcWidth; i++) {
                for (int j = 0; j < height; j++) {
                    DataCopy(dst[dstOffset], src[srcOffset], { 1, 1, 0, 0 }, enhancedParams);
                    dstOffset += c0Size_;
                    srcOffset += gCol;
