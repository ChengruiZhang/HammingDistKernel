            int32_t kL0Len = cast_to_KLoop()->GetBaseShape();
            if constexpr (HasSparseIndex<B_TYPE>()) {
                if (!(cast_to_TBufPoolL0()->template Hit<TPosition::B2>(posB))) {
                    LocalTensor<TransBT> b2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();
                    cast_to_LoadToB2()->Load(b2, b1, bL0Params.axisL1Len, bL0Params.kAxisL1Len,
                        bL0Params.axisL0Len, cast_to_KLoop()->GetBaseShape(), bL0Params.axisL1Offset,
                        bL0Params.kAxisL1Offset, isBTranspose, cast_to_CopyCubeInB()->GetSparseIndex());
                    return b2;
                } else {
                    return cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();
