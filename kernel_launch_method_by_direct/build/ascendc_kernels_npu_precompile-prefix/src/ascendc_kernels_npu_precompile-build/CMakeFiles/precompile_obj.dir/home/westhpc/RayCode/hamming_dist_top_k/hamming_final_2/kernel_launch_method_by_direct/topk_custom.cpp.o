    {
        if constexpr (INPUT_TYPE::TAG == InputTypeTag::B) {
            return cast_to_MatmulShapeTiling()->GetTiling().GetStepKb() *
                cast_to_MatmulShapeTiling()->GetTiling().GetStepN();
        } else {
            return cast_to_MatmulShapeTiling()->GetTiling().GetStepKa() *
                cast_to_MatmulShapeTiling()->GetTiling().GetStepM();
