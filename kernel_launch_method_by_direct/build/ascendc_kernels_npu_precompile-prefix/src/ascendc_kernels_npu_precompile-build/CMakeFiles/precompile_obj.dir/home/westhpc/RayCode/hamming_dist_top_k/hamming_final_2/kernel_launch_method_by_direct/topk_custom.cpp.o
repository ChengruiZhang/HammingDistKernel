    {
        (static_cast<gCO1QueType*>(gCO1Que))->FreeTensor(co1Local);
        if constexpr (ToMatmulConfig(MM_CFG).iterateMode != IterateMode::ITERATE_MODE_ALL) {
            co1UsedNumber--;
            for (int i = 0; i < co1UsedNumber; i++) {
