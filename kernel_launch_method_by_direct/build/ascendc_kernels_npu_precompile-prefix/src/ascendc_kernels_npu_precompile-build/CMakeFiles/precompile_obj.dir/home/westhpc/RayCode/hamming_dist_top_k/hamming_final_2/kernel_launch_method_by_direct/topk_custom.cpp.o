    LocalTensor<TensorTrait<SrcBT>> rightMatrix_;
    LocalTensor<TensorTrait<BiasT>> inputBias_;

    __attribute__((cce_global)) SrcT* aGlobal_;
    __attribute__((cce_global)) SrcBT* bGlobal_;
    __attribute__((cce_global)) BiasT* biasGlobal_;

    TPipe* tpipe_;



    int baseUseM_;
    int baseUseK_;
    int baseUseN_;

    int blockUseM_;
    int blockUseK_;
    int blockUseN_;


    bool isFirstIter_;

    bool enableBias_;

    int tailM_, tailK_, tailN_;

    int curM_, curN_;

    int curStepM_, curStepN_;

    int stepMIdx_, stepNIdx_;

    bool enHF32Mode_;
    int32_t hf32TransMode_;

    int baseMN_;
};

