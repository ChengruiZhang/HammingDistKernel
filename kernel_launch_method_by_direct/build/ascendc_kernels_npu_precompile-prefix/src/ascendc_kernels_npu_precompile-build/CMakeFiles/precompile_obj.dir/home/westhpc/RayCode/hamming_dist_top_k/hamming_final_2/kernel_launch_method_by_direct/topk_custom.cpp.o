    [aicore] inline void ComputeOneIter(bool enPartialSum)
    {

        SplitParams aL0Params = BASE_MODULE::InitSplitAParams();
        SplitParams bL0Params = BASE_MODULE::InitSplitBParams();

        cast_to_KLoop()->OuterStart();

        LocalTensor<TransAT> a1 = cast_to_CopyCubeInA()->LoadData(
            0, 0, cast_to_MLoop()->GetTileShape(), cast_to_KLoop()->GetTileShapeA());
        LocalTensor<TransBT> b1 = cast_to_CopyCubeInB()->LoadData(
            0, 0, cast_to_KLoop()->GetTileShapeB(), cast_to_NLoop()->GetTileShape());

