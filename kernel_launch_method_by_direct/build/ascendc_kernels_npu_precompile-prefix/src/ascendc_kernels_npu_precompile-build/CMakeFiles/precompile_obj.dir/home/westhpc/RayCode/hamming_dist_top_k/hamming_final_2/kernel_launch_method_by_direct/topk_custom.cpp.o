namespace AscendC {

struct CumSumConfig {
    bool isLastAxis{true};
    bool isReuseSource{false};
    bool outputLastRow{false};
};

struct CumSumInfo {
    uint32_t outter{0};
    uint32_t inner{0};
};

};
