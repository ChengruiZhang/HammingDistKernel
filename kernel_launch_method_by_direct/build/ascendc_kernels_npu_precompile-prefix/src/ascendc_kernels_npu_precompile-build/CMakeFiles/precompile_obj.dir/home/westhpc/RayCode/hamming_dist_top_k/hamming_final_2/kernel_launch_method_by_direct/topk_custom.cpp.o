namespace Detail {

struct DfxHandler {
    template <typename... Args>
    [aicore] inline static void PreCall(const DfxFuncInfo& info, Args&&... args) {
        DfxConfig::EnabledHandlers::PreCall(info, std::forward<Args>(args)...);
    }

    template <typename RT>
    [aicore] inline static void PostCall(const DfxFuncInfo& info, const RT& ret) {
        DfxConfig::EnabledHandlers::PostCall(info, ret);
    }

    [aicore] inline static void PostCall(const DfxFuncInfo& info) {
        DfxConfig::EnabledHandlers::PostCall(info);
    }
};

}
}
