        if constexpr (ToMatmulConfig(MM_CFG).isNBatchOut) {
            fixpipe.SetNdParams(cast_to_BatchLoop()->GetBatchOutCacheNum(), baseHeight, baseWidth, baseBlockWidth,
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseM(),
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseN());
