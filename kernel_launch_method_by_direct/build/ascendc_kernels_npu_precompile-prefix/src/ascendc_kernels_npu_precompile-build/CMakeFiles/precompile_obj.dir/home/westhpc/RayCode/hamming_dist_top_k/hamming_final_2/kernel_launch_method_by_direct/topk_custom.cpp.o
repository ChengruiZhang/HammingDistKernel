                shareTmpBuffer, epsilon, normallizepara);
        } else {
            Normalize<U, T, false, NLCFG_NOOPT>(output, outputRstd, outputMean, variance, inputX, gamma, beta,
                shareTmpBuffer, epsilon, normallizepara);
