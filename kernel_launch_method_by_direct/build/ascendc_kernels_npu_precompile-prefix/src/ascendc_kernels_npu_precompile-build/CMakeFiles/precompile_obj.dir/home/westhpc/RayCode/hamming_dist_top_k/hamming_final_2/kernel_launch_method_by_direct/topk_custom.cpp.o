            int blockLen = calcWidthExr * (c0Size_ * sizeof(TransT) / DEFAULT_C0_SIZE);


            int srcGap = gCol * sizeof(TransT) / ONE_BLK_SIZE - 1;
            if (gCol % c0Size_ || srcGap >= (65535)) {

