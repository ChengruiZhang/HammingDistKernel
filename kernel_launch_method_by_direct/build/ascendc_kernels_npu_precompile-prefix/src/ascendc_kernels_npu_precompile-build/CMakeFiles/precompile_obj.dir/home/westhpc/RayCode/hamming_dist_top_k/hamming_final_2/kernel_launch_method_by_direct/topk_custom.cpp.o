[aicore] inline void DataCopyGM2UBND2NZImpl(__attribute__((cce_unif_buff)) float* dst, __attribute__((cce_global)) float* src, const Nd2NzParams& intriParams)
{
    if constexpr(g_coreType != AscendC::AIV) {
