        cast_to_BatchScheduler()->SetNBatchOutNum(nBatchOutNum);
        cast_to_BatchLoop()->SetNBatchOutNum(nBatchOutNum);
    }

    [aicore] inline void IterateBatch(const GlobalTensor<DstT>& gm,
        bool enPartialSum, uint8_t enAtomic, bool enSequentialWrite, const uint32_t matrixStrideA = 0,
