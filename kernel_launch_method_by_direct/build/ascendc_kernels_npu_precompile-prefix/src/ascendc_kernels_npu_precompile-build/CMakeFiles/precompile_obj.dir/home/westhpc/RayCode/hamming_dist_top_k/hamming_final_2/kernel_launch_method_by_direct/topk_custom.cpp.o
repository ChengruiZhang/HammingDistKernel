        if constexpr (PhyPosIsL1(BIAS_TYPE::pos)) {
            biasC1 = (BASE_MODULE::srcTensor_)[srcOffset];
        } else if (BASE_MODULE::enableBias_ && cast_to_KLoop()->FirstOuterIter()) {
            biasC1 = cast_to_C1Buffer()->AllocTensor();
            cast_to_CopyBiasIn()->Copy(biasC1, BASE_MODULE::srcTensor_, dataLen, dataNum,
                                            srcOffset + BASE_MODULE::singleOffset_);
            cast_to_C1Buffer()->EnQue(biasC1);
            cast_to_C1Buffer()->DeQue();
        }
        return biasC1;
    }

    [aicore] inline void Free(LocalTensor<BiasT> &biasC1)
    {

        if (!PhyPosIsL1(BIAS_TYPE::pos) && BASE_MODULE::enableBias_ && cast_to_KLoop()->FirstOuterIter()) {
            cast_to_C1Buffer()->FreeTensor(biasC1);
        }
    }

    [aicore] inline void SplitLoad(LocalTensor<BiasT> &biasC1, int32_t dataLen, int32_t srcOffset = 0)
    {
        if (BASE_MODULE::enableBias_ && cast_to_KLoop()->FirstOuterIter()) {
            auto biasC2 = cast_to_C2Buffer()->Allocate();
            cast_to_LoadBias2C2()->Load(biasC2, biasC1[srcOffset], dataLen);
            cast_to_C2Buffer()->EnQue();
            cast_to_C2Buffer()->DeQue();
        }
    }

    [aicore] inline void Free()
    {
        if (BASE_MODULE::enableBias_ && cast_to_KLoop()->FirstOuterIter() &&
            cast_to_KLoop()->FirstInnerIter()) {
            cast_to_C2Buffer()->Free();
        }
    }

    [aicore] inline void End()
    {
        if (cast_to_MatmulShapeTiling()->GetTiling().IsBias()) {
            cast_to_C1Buffer()->Destroy();
        }
    }

private:
    constexpr static int32_t DB_NUM = 2;
    constexpr static bool isL0DBScene_ = (MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB() &&
                                          ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_M);
};

}
