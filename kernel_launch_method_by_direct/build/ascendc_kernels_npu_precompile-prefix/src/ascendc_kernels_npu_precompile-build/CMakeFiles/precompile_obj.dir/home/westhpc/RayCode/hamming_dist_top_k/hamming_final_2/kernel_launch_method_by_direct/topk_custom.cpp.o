    using TransAT = typename A_TYPE::T;
    using TransBT = typename decltype(GetTransBDataType<A_TYPE, B_TYPE, MM_CFG>())::T;
    using BiasT = typename BIAS_TYPE::T;
    using DstT = typename C_TYPE::T;
    using L0cT = typename GetMmDstType<typename A_TYPE::T>::Type;

public:
    using BASE_MODULE =
        AscendC::Impl::Detail::MatmulMDLSchedulerBase<IMPL, A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, POLICY_TYPE>;

    [aicore] inline void GetResult(const GlobalTensor<DstT>& gm, uint8_t enAtomic = 0, bool enSequentialWrite = false)
    {
        if constexpr (MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
            GetResultImpl(gm, enAtomic, enSequentialWrite);
        } else {
            BASE_MODULE::GetResult(gm, enAtomic, enSequentialWrite);
        }
    }

    [aicore] inline void GetResult(const LocalTensor<DstT>& co2Local, uint8_t enAtomic = 0,
        bool enSequentialWrite = false)
    {
        if constexpr (MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
            static_assert(ToMatmulConfig(MM_CFG).scheduleType != ScheduleType::OUTER_PRODUCT,
                "When scheduleType is OUTER_PRODUCT, GetResult function of LocalTensor output is not supported.");
        } else {
            BASE_MODULE::GetResult(co2Local, enAtomic, enSequentialWrite);
        }
    }

    [aicore] inline void ReduceK(bool enPartialSum)
    {
        if (!BASE_MODULE::IsInTrianMatmul()) {
            return;
        }
        if (BASE_MODULE::IsMDLKFullLoad()) {

            ReduceKOneIter(enPartialSum);
        } else {
            ReduceKMultiIter(enPartialSum);
        }
    }

    [aicore] inline LocalTensor<BiasT> SplitBias(const int32_t dataLen)
    {
        if constexpr (MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
            auto bias = cast_to_BiasScheduler()->CopyIn(cast_to_NLoop()->GetBaseShape(), 1,
            cast_to_NLoop()->GetInnerIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetBaseN());

            if constexpr(ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_N) {
                cast_to_BiasScheduler()->SplitLoad(bias, dataLen);
            }
            return bias;
        } else {
            auto bias = cast_to_BiasScheduler()->CopyIn(cast_to_NLoop()->GetBaseShape(), 1,
                cast_to_NLoop()->GetInnerIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetBaseN());
            cast_to_BiasScheduler()->SplitLoad(bias, dataLen);
            cast_to_BiasScheduler()->Free(bias);
            return {};
        }
    }

private:
    [aicore] inline void ReduceKOneIter(bool enPartialSum)
    {

        SplitParams aL0Params = BASE_MODULE::InitSplitAParams();
        SplitParams bL0Params = BASE_MODULE::InitSplitBParams();
        cast_to_KLoop()->OuterStart();

        LocalTensor<TransAT> a1;
        LocalTensor<TransBT> b1;
        BASE_MODULE::CopyIn(a1, b1);
        bool isATranspose = cast_to_MatmulShapeInfo()->IsTransposeA();
        bool isBTranspose = cast_to_MatmulShapeInfo()->IsTransposeB();
        SplitPrepareOneIter(isATranspose, isBTranspose, aL0Params, bL0Params);
        LocalTensor<BiasT> bias = SplitBias(bL0Params.axisL0Len);
        int32_t kL1Stride;
        if constexpr (IsStaticPaddingEnable(MM_CFG)) {
            kL1Stride = cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
        } else {
            kL1Stride = cast_to_KLoop()->GetBaseBlockShape() * BASE_MODULE::c0Size_;
        }

        cast_to_KLoop()->InnerStart();
        do {
            if constexpr (MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
                if constexpr(ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_N) {
                    ComputeMDB(a1, b1, bias, aL0Params, bL0Params, isATranspose, isBTranspose, !enPartialSum, true);
                } else if constexpr(ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_M) {
                    ComputeNDB(a1, b1, bias, aL0Params, bL0Params, isATranspose, isBTranspose, !enPartialSum, true);
                }
            } else {
                ComputeKDB(a1, b1, aL0Params, bL0Params, isATranspose, isBTranspose, !enPartialSum, true);
            }
            aL0Params.kAxisL1Offset += kL1Stride;
            bL0Params.kAxisL1Offset += kL1Stride;
        } while (cast_to_KLoop()->InnerNext());
        if constexpr (MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
            cast_to_BiasScheduler()->Free(bias);
        }
        BASE_MODULE::DoPreloadAWait();
    }

    [aicore] inline void ReduceKMultiIter(bool enPartialSum)
    {

        SplitParams aL0Params = BASE_MODULE::InitSplitAParams();
        SplitParams bL0Params = BASE_MODULE::InitSplitBParams();
        bool isATranspose = cast_to_MatmulShapeInfo()->IsTransposeA();
        bool isBTranspose = cast_to_MatmulShapeInfo()->IsTransposeB();

        cast_to_KLoop()->OuterStart();

        int32_t curKaOuterIdx = cast_to_KLoop()->GetOuterKaIdx();
        int32_t curKbOuterIdx = cast_to_KLoop()->GetOuterKbIdx();
        do {

            LocalTensor<TransAT> a1;
            LocalTensor<TransBT> b1;
            BASE_MODULE::CopyIn(a1, b1);
            LocalTensor<BiasT> bias = SplitBias(bL0Params.axisL0Len);
            Compute(a1, b1, bias, enPartialSum, isATranspose, isBTranspose, aL0Params, bL0Params);
            if constexpr (MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
                cast_to_BiasScheduler()->Free(bias);
            }
            BASE_MODULE::DoPreloadAWait();
            BASE_MODULE::ClearL1BufferCache(curKaOuterIdx, curKbOuterIdx);
        } while (cast_to_KLoop()->OuterNext());
        BASE_MODULE::ResetCopyInBuffer();
    }

    [aicore] inline void Compute(const LocalTensor<TransAT>& a1, const LocalTensor<TransBT>& b1,
        LocalTensor<BiasT>& bias, const bool enPartialSum, const bool isATranspose, const bool isBTranspose,
        SplitParams& aL0Params, SplitParams& bL0Params)
    {

        bool sL0CInit = false;
        bool sL0CLast = false;
        BASE_MODULE::SplitPrepare(enPartialSum, isATranspose, isBTranspose, aL0Params, bL0Params, sL0CInit, sL0CLast);

        int32_t kL1Stride = cast_to_KLoop()->GetBaseBlockShape() * BASE_MODULE::c0Size_;

        cast_to_KLoop()->InnerStart();
        do {
            if constexpr (MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
                if constexpr(ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_N) {
                    ComputeMDB(a1, b1, bias, aL0Params, bL0Params, isATranspose, isBTranspose, sL0CInit, sL0CLast);
                } else if constexpr(ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_M) {
                    ComputeNDB(a1, b1, bias, aL0Params, bL0Params, isATranspose, isBTranspose, sL0CInit, sL0CLast);
                }
            } else {
                ComputeKDB(a1, b1, aL0Params, bL0Params, isATranspose, isBTranspose, sL0CInit, sL0CLast);
            }
            aL0Params.kAxisL1Offset += kL1Stride;
            bL0Params.kAxisL1Offset += kL1Stride;
        } while (cast_to_KLoop()->InnerNext());
    }

    [aicore] inline void ComputeKDB(const LocalTensor<TransAT>& a1, const LocalTensor<TransBT>& b1,
        const SplitParams& aL0Params, const SplitParams& bL0Params,
        const bool isATranspose, const bool isBTranspose, const bool sL0CInit, const bool sL0CLast)
    {
        cast_to_TBufPoolL0()->Allocate();
        LocalTensor<TransAT> a2 = BASE_MODULE::SplitA(a1, aL0Params, isATranspose);
        LocalTensor<TransBT> b2 = BASE_MODULE::SplitB(b1, bL0Params, isBTranspose);
        cast_to_TBufPoolL0()->EnQue();
        cast_to_TBufPoolL0()->DeQue();
        BASE_MODULE::CubeCompute(cast_to_CubeOutBuffer()->GetTensor(), a2, b2, aL0Params.axisL0Len,
            bL0Params.axisL0Len, cast_to_KLoop()->GetBaseShape(), isATranspose, isBTranspose, sL0CInit, sL0CLast);
        cast_to_TBufPoolL0()->Free();
        cast_to_BiasScheduler()->Free();
    }

    [aicore] inline void ComputeMDB(const LocalTensor<TransAT>& a1, const LocalTensor<TransBT>& b1,
        LocalTensor<BiasT>& bias, SplitParams& aL0Params, SplitParams& bL0Params, bool isATranspose,
        bool isBTranspose, bool sL0CInit, bool sL0CLast)
    {
        uint32_t l0aDBLoop = cast_to_MLoop()->GetL0DBLoopNum();
        for (uint32_t idx = 0; idx < l0aDBLoop; ++idx) {

            auto& bufferPool = cast_to_TBufPoolL0()->Allocate();

            aL0Params.axisL1Offset += (idx * aL0Params.axisL0Len);
            LocalTensor<TransAT> a2 = BASE_MODULE::SplitA(a1, aL0Params, isATranspose);

            LocalTensor<TransBT> b2 = BASE_MODULE::SplitB(b1, bL0Params, isBTranspose);
            bufferPool.EnQue();
            bufferPool.DeQue();

            BASE_MODULE::CubeCompute(cast_to_CubeOutBuffer()->GetTensor()[idx *
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() *
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseN()],
                a2, b2, aL0Params.axisL0Len, bL0Params.axisL0Len, cast_to_KLoop()->GetBaseShape(),
                isATranspose, isBTranspose, sL0CInit, sL0CLast);
            bufferPool.Free();
        }
        cast_to_BiasScheduler()->Free();
    }

    [aicore] inline void ComputeNDB(const LocalTensor<TransAT>& a1, const LocalTensor<TransBT>& b1, LocalTensor<BiasT>& bias,
        SplitParams& aL0Params, SplitParams& bL0Params, bool isATranspose, bool isBTranspose, bool sL0CInit, bool sL0CLast)
    {
        uint32_t l0bDBLoop = cast_to_NLoop()->GetL0DBLoopNum();
        for (uint32_t idx = 0; idx < l0bDBLoop; ++idx) {

            auto& bufferPool = cast_to_TBufPoolL0()->Allocate();

            LocalTensor<TransAT> a2 = BASE_MODULE::SplitA(a1, aL0Params, isATranspose);

            bL0Params.axisL1Offset += (idx * bL0Params.axisL0Len);
            LocalTensor<TransBT> b2 = BASE_MODULE::SplitB(b1, bL0Params, isBTranspose);
            bufferPool.EnQue();
            bufferPool.DeQue();

            cast_to_BiasScheduler()->SplitLoad(bias, bL0Params.axisL0Len, idx * bL0Params.axisL0Len);

            BASE_MODULE::CubeCompute(cast_to_CubeOutBuffer()->GetTensor()[idx *
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() *
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseN()],
                a2, b2, aL0Params.axisL0Len, bL0Params.axisL0Len, cast_to_KLoop()->GetBaseShape(),
                isATranspose, isBTranspose, sL0CInit, sL0CLast);
            bufferPool.Free();
            cast_to_BiasScheduler()->Free();
        }
    }

    [aicore] inline void SplitPrepareOneIter(const bool isATranspose, const bool isBTranspose,
        SplitParams& aL0Params, SplitParams& bL0Params)
    {
        aL0Params.kAxisL1Offset = 0;
        bL0Params.kAxisL1Offset = 0;
        if constexpr (PhyPosIsL1OrUB<MM_CFG>((A_TYPE::pos)) && IsStaticPaddingEnable(MM_CFG)) {
            aL0Params.kAxisL1Len = cast_to_MatmulShapeTiling()->GetTiling().GetSingleCoreK();
        } else if constexpr (PhyPosIsL1OrUB<MM_CFG>((A_TYPE::pos)) && (IsFullStaticTiling(MM_CFG) || MatmulFeatureTrait<MM_CFG>::IsSupportUBToL1Singleshape())) {
            aL0Params.kAxisL1Len = cast_to_MatmulShapeInfo()->GetOrgKa() != -1 ?
                cast_to_MatmulShapeInfo()->GetOrgKa() :
                cast_to_MatmulShapeTiling()->GetTiling().GetSingleCoreK();
        } else {
            aL0Params.kAxisL1Len = cast_to_KLoop()->GetTileBlockShapeA() * BASE_MODULE::c0Size_;
        }
        if constexpr (PhyPosIsL1OrUB<MM_CFG>((B_TYPE::pos)) && IsStaticPaddingEnable(MM_CFG)) {
            bL0Params.kAxisL1Len = cast_to_MatmulShapeTiling()->GetTiling().GetSingleCoreK();
        } else if constexpr (PhyPosIsL1OrUB<MM_CFG>((B_TYPE::pos)) && (IsFullStaticTiling(MM_CFG) || MatmulFeatureTrait<MM_CFG>::IsSupportUBToL1Singleshape())) {
            bL0Params.kAxisL1Len = cast_to_MatmulShapeInfo()->GetOrgKb() != -1 ?
                cast_to_MatmulShapeInfo()->GetOrgKb() :
                cast_to_MatmulShapeTiling()->GetTiling().GetSingleCoreK();
        } else {
            bL0Params.kAxisL1Len = cast_to_KLoop()->GetTileBlockShapeB() * BASE_MODULE::c0Size_;
        }
        cast_to_LoadToA2()->Prepare(isATranspose, aL0Params.kAxisL1Len, aL0Params.axisL1Len);
        cast_to_LoadToB2()->Prepare(isBTranspose, bL0Params.kAxisL1Len);
    }

    [aicore] inline void GetResultImpl(const GlobalTensor<DstT>& gm, uint8_t enAtomic, bool enSequentialWrite)
    {
        auto co1Local = cast_to_CubeOutBuffer()->GetTensor();
        cast_to_CubeOutBuffer()->EnQue(co1Local);
        cast_to_CubeOutBuffer()->DeQue();
        int32_t co1Offset = cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() *
            cast_to_MatmulShapeTiling()->GetTiling().GetBaseN();
        if (cast_to_NLoop()->GetL0DBLoopNum() > 1) {
            FixpipeL0CToGm(gm, co1Local, cast_to_MLoop()->GetInnerIdx(), cast_to_NLoop()->GetInnerIdx(),
                enAtomic, enSequentialWrite);
            FixpipeL0CToGm(gm, co1Local[co1Offset], cast_to_MLoop()->GetInnerIdx(),
                cast_to_NLoop()->GetInnerIdx() + 1, enAtomic, enSequentialWrite);
        } else if (cast_to_MLoop()->GetL0DBLoopNum() > 1) {
            FixpipeL0CToGm(gm, co1Local,
                cast_to_MLoop()->GetInnerIdx(), cast_to_NLoop()->GetInnerIdx(), enAtomic, enSequentialWrite);
            FixpipeL0CToGm(gm, co1Local[co1Offset], cast_to_MLoop()->GetInnerIdx() + 1,
                cast_to_NLoop()->GetInnerIdx(), enAtomic, enSequentialWrite);
        } else {
            FixpipeL0CToGm(gm, co1Local, cast_to_MLoop()->GetInnerIdx(), cast_to_NLoop()->GetInnerIdx(),
                enAtomic, enSequentialWrite);
        }
        cast_to_CubeOutBuffer()->FreeTensor(co1Local);
    }

    [aicore] inline void FixpipeL0CToGm(const GlobalTensor<DstT>& gm, const LocalTensor<L0cT>& co1Local,
        int32_t curM, int32_t curN, uint8_t enAtomic, bool enSequentialWrite)
    {
        if constexpr (C_TYPE::format != CubeFormat::ND && C_TYPE::format != CubeFormat::ND_ALIGN &&
            C_TYPE::format != CubeFormat::NZ && C_TYPE::format != CubeFormat::COLUMN_MAJOR) {

                                                                                                                   ;
        }
        if (enAtomic == ATOMIC_ADD) {
            SetAtomicAdd<DstT>();
        } else if (enAtomic == ATOMIC_MAX) {
            SetAtomicMax<DstT>();
        } else if (enAtomic == ATOMIC_MIN) {
            SetAtomicMin<DstT>();
        }
        if (enSequentialWrite) {
            cast_to_CopyCubeOut()->template Copy<true>(gm, co1Local, curM, curN,
                cast_to_MLoop()->GetBaseShape(), cast_to_NLoop()->GetBaseShape(),
                cast_to_MLoop()->GetBaseBlockShape(), cast_to_NLoop()->GetBaseBlockShape());
        } else {
            cast_to_CopyCubeOut()->template Copy<false>(gm, co1Local, curM, curN,
                cast_to_MLoop()->GetBaseShape(), cast_to_NLoop()->GetBaseShape(),
                cast_to_MLoop()->GetBaseBlockShape(), cast_to_NLoop()->GetBaseBlockShape());
        }

        if (enAtomic != 0) {
            SetAtomicNone();
        }
    }
};

}
}
