        localWorkspace.SetSize(cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() *
            cast_to_MatmulShapeTiling()->GetTiling().GetBaseN());
        return localWorkspace;
    }

private:
    [aicore] inline int32_t GetAUsedSpace()
    {
        constexpr int32_t c0Size = AuxGetC0Size<SrcT>();
        if constexpr (A_TYPE::pos != TPosition::TSCM) {
            if (!cast_to_MatmulShapeInfo()->IsTransposeA() && (cast_to_MatmulShapeTiling()->GetTiling().GetSingleCoreK() % c0Size != 0)) {
                return cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() * ONE_BLK_SIZE;
            } else if (cast_to_MatmulShapeInfo()->IsTransposeA() && (cast_to_MatmulShapeTiling()->GetTiling().GetSingleCoreM() % c0Size != 0)) {
                return cast_to_MatmulShapeTiling()->GetTiling().GetBaseK() * ONE_BLK_SIZE;
            }
        }
        return 0;
    }

    [aicore] inline int32_t GetBUsedSpace()
    {
        constexpr int32_t c0Size = AuxGetC0Size<SrcT>();
        constexpr int32_t bUsedSize = 2;
        if constexpr (B_TYPE::pos != TPosition::TSCM) {
            if (IsSameType<typename A_TYPE::T, int8_t>::value && IsSameType<typename B_TYPE::T, int8_t>::value &&
                !B_TYPE::isTrans && B_TYPE::format == CubeFormat::ND) {
                if constexpr (DoMatmulNorm(MM_CFG) || DoMatmulBasicBlock(MM_CFG)) {
