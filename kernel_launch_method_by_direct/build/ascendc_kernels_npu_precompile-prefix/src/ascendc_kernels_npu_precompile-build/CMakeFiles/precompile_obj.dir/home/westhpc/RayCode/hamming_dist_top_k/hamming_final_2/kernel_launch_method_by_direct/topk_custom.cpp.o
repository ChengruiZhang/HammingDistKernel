protected:
    template <PolicyType P>
    [aicore] inline enable_if_t<P != PolicyType::MATMUL_NBUFFER_33, void>
    SetSingleShapeImpl(int32_t singleShape, AscendC::Std::integral_constant<PolicyType, P>)
    {
