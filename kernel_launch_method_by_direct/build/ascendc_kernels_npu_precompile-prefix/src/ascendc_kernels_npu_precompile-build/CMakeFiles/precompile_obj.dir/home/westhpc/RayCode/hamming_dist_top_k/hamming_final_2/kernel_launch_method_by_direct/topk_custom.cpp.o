template <typename IMPL, const auto& MM_CFG, class INPUT_TYPE>
class CopyTileToCubeWrapper<IMPL, MM_CFG, INPUT_TYPE, enable_if_t<!MatmulFeatureTrait<MM_CFG>::IsNeedUB() &&
    !(INPUT_TYPE::TAG == InputTypeTag::scaleA || INPUT_TYPE::TAG == InputTypeTag::scaleB)>> {
    using TransT = typename INPUT_TYPE::TRANS_T;
    using SrcT = typename INPUT_TYPE::T;

    [aicore] inline constexpr decltype(auto) cast_to_CopyCubeInParams() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG> > (*(static_cast<typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_CopyCubeInParams() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG> > (*(static_cast<const typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_MatmulTensorInfo() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG> > (*(static_cast<typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulTensorInfo() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG> > (*(static_cast<const typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_DataCopyWrapper() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::template DataCopyWrapper<INPUT_TYPE::TAG> > (*(static_cast<typename IMPL::template DataCopyWrapper<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::template DataCopyWrapper<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_DataCopyWrapper() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::template DataCopyWrapper<INPUT_TYPE::TAG> > (*(static_cast<const typename IMPL::template DataCopyWrapper<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::template DataCopyWrapper<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeInfo() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulShapeInfo> (*(static_cast<typename IMPL::MatmulShapeInfo*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulShapeInfo*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeInfo() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulShapeInfo> (*(static_cast<const typename IMPL::MatmulShapeInfo*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulShapeInfo*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_MatmulUserDefineInfo() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulUserDefineInfo> (*(static_cast<typename IMPL::MatmulUserDefineInfo*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulUserDefineInfo*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulUserDefineInfo() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulUserDefineInfo> (*(static_cast<const typename IMPL::MatmulUserDefineInfo*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulUserDefineInfo*>(static_cast<const IMPL*>(this))); } };

public:
    [aicore] inline CopyTileToCubeWrapper() = default;
    [aicore] inline ~CopyTileToCubeWrapper() = default;

    template <bool IS_INTRA_BLOCK = false>
    [aicore] inline void CopyTileToCube(const LocalTensor<TransT>& dst, int32_t curRow, int32_t curCol,
        int32_t tileHeight, int32_t tileWidth)
    {




        if constexpr ((INPUT_TYPE::TAG == InputTypeTag::A && IMPL::CallBack::CopyA1Ptr) ||
            (INPUT_TYPE::TAG == InputTypeTag::B && IMPL::CallBack::CopyB1Ptr)) {

            CopyTileToCubeByCallBack(dst, curRow, curCol, tileHeight, tileWidth);
        } else {
            constexpr int32_t widthFactor =
                IsSupportB4<TransT>() && INPUT_TYPE::format == CubeFormat::ND ? INT4_TWO : 1;
            if (IsTranspose<IS_INTRA_BLOCK>()) {
                if constexpr (IsCopyFromUB<INPUT_TYPE, MM_CFG>()) {
                    LocalTensor<SrcT> src;
                    src.SetAddr(cast_to_MatmulTensorInfo()->GetLocalTensor().address_);
                    CopyTileToCubeFromUB<true, IS_INTRA_BLOCK>(
                        dst, src, curCol, curRow, tileWidth, tileHeight / widthFactor, widthFactor);
                } else {
                    GlobalTensor<SrcT> src;
                    src.SetGlobalBuffer(cast_to_MatmulTensorInfo()->template GetGlobalTensor<IS_INTRA_BLOCK>().address_);
                    if constexpr (HasSparseIndex<INPUT_TYPE>() && INPUT_TYPE::TAG == InputTypeTag::B) {
                        CopyTileToCubeFromGM(dst, src, curCol, curRow, tileWidth, tileHeight,
                            cast_to_CopyCubeInParams()->template GetBaseHeight<true>(),
                            cast_to_CopyCubeInParams()->template GetBaseWidth<true>() >> 1,
                            cast_to_CopyCubeInParams()->template GetOrgHeight<true, IS_INTRA_BLOCK>(),
                            cast_to_CopyCubeInParams()->template GetOrgWidth<true, IS_INTRA_BLOCK>() >> 1,
                            cast_to_CopyCubeInParams()->template GetStepCol<false>(),
                            cast_to_CopyCubeInParams()->template IsKRowDirec<IS_INTRA_BLOCK>());
                    } else {
                        CopyTileToCubeFromGM(dst, src, curCol, curRow, tileWidth, tileHeight / widthFactor,
                            cast_to_CopyCubeInParams()->template GetBaseHeight<true>(),
                            cast_to_CopyCubeInParams()->template GetBaseWidth<true>(),
                            cast_to_CopyCubeInParams()->template GetOrgHeight<true, IS_INTRA_BLOCK>(),
                            cast_to_CopyCubeInParams()->template GetOrgWidth<true, IS_INTRA_BLOCK>() / widthFactor,
                            cast_to_CopyCubeInParams()->template GetStepCol<false>(),
                            cast_to_CopyCubeInParams()->template IsKRowDirec<IS_INTRA_BLOCK>());
                    }
                }
            } else {

                Barrier();

                if constexpr (IsCopyFromUB<INPUT_TYPE, MM_CFG>()) {
                    LocalTensor<SrcT> src;
                    src.SetAddr(cast_to_MatmulTensorInfo()->GetLocalTensor().address_);
                    CopyTileToCubeFromUB<false, IS_INTRA_BLOCK>(
                        dst, src, curRow, curCol, tileHeight, tileWidth / widthFactor, widthFactor);
                } else {
                    GlobalTensor<SrcT> src;
                    src.SetGlobalBuffer(cast_to_MatmulTensorInfo()->template GetGlobalTensor<IS_INTRA_BLOCK>().address_);
                    CopyTileToCubeFromGM(
                        dst, src, curRow, curCol, tileHeight, tileWidth / widthFactor,
                        cast_to_CopyCubeInParams()->template GetBaseHeight<false>(),
                        cast_to_CopyCubeInParams()->template GetBaseWidth<false>(),
                        cast_to_CopyCubeInParams()->template GetOrgHeight<false, IS_INTRA_BLOCK>(),
                        cast_to_CopyCubeInParams()->template GetOrgWidth<false, IS_INTRA_BLOCK>() / widthFactor,
                        cast_to_CopyCubeInParams()->template GetStepCol<false>(),
                        cast_to_CopyCubeInParams()->template IsKRowDirec<IS_INTRA_BLOCK>());
                }
            }
        }
    }

    template <bool IS_INTRA_BLOCK = false>
    [aicore] inline void CopySparseIdxToCubeFromGM(const LocalTensor<uint8_t>& dst, const GlobalTensor<uint8_t>& src,
        int32_t curRow, int32_t curCol, int32_t tileHeight, int32_t tileWidth)
    {



          ;
        int32_t baseHeight = cast_to_CopyCubeInParams()->template GetBaseHeight<true>();
        int32_t baseWidth = cast_to_CopyCubeInParams()->template GetBaseWidth<true>() >> 3;
        int32_t orgHeight = cast_to_CopyCubeInParams()->template GetOrgHeight<true, IS_INTRA_BLOCK>();
        int32_t row = curCol * baseHeight;
        int32_t col = curRow * baseWidth;
        int32_t height = tileWidth;
        int32_t width = tileHeight >> 2;
        constexpr int32_t c0Size = AuxGetC0Size<int32_t>();




          ;
        int32_t alignedGRow = Ceil(orgHeight, BLOCK_CUBE) * BLOCK_CUBE;
        int64_t srcOffset = (int64_t)row * (int64_t)c0Size + (int64_t)col * (int64_t)alignedGRow;

        auto alignedHeight = Ceil(height, BLOCK_CUBE) * BLOCK_CUBE;
        int32_t blockLen = (alignedHeight * c0Size * sizeof(uint8_t)) / ONE_BLK_SIZE;
        int32_t srcStride = ((alignedGRow - alignedHeight) * c0Size * sizeof(uint8_t)) / ONE_BLK_SIZE;
        uint16_t nburst = Ceil(width, c0Size);
        if (srcStride >= (65535)) {
            for (int32_t i = 0; i < nburst; ++i) {
                DataCopy(dst[i * alignedHeight * c0Size], src[srcOffset],
                    { 1, static_cast<uint16_t>(blockLen), 0, 0 });
                srcOffset += orgHeight * c0Size;
            }
        } else {
            DataCopy(dst, src[srcOffset], { nburst, static_cast<uint16_t>(blockLen), static_cast<uint16_t>(srcStride), 0 });
        }
    }

private:
    constexpr static int32_t c0Size_ = AuxGetC0Size<SrcT>();

    template <bool IS_INTRA_BLOCK = false>
    [aicore] inline bool IsTranspose()
    {
        if constexpr(INPUT_TYPE::TAG == InputTypeTag::A) {
            if constexpr(INPUT_TYPE::format == CubeFormat::COLUMN_MAJOR) {
                return !cast_to_MatmulShapeInfo()->template IsTransposeA<IS_INTRA_BLOCK>();
            } else {
                return cast_to_MatmulShapeInfo()->template IsTransposeA<IS_INTRA_BLOCK>();
            }
        } else {
            if constexpr(INPUT_TYPE::format == CubeFormat::COLUMN_MAJOR) {
                return !cast_to_MatmulShapeInfo()->template IsTransposeB<IS_INTRA_BLOCK>();
            } else {
                return cast_to_MatmulShapeInfo()->template IsTransposeB<IS_INTRA_BLOCK>();
            }
        }
    }

    template <bool IS_INTRA_BLOCK = false>
