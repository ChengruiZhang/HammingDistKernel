        LocalTensor<TransT> l1;
        int32_t posL1 = BASE_MODULE::GetIterIndex(curRow, curCol);
        int32_t bufferPos = cast_to_CopyCubeInParams()->GetBufferPos();
        if (cast_to_CubeInBuffer()->Hit(posL1, bufferPos)) {
            l1 = cast_to_CubeInBuffer()->GetBuffer(posL1, bufferPos);
