    }

    [aicore] inline LocalTensor<TransT> GetBuffer(int32_t iterIndex, int32_t bufferPos = -1)
    {
        (void) bufferPos;
        return cacheHead_[iterIndex * baseBlockSize_];
    }

    [aicore] inline void EnQue(LocalTensor<TransT>& tensor)
    {
        if (cacheAlloc_) {
            qidCache_.EnQue(tensor);
        } else {
            qid_.EnQue(tensor);
        }
    }

    [aicore] inline void DeQue()
    {
        if (cacheAlloc_) {
            (void) qidCache_.DeQue();
        } else {
            (void) qid_.DeQue();
        }
    }

private:

    [aicore] inline int32_t GetMajorCacheNum()
    {
        if constexpr (INPUT_TYPE::TAG == InputTypeTag::A) {
            if constexpr (DoMatmulSpecialBasicBlock(MM_CFG)) {
                return ToMatmulConfig(MM_CFG).stepM;
            } else {
                return cast_to_MatmulShapeTiling()->GetTiling().GetStepM();
            }
        } else {
            if constexpr (DoMatmulSpecialBasicBlock(MM_CFG)) {
                return ToMatmulConfig(MM_CFG).stepN;
            } else {
                return cast_to_MatmulShapeTiling()->GetTiling().GetStepN();
            }
        }
    }

