            if constexpr (MatmulFeatureTrait<MM_CFG>::IsSupportL0CToUB() && PhyPosIsUB(C_TYPE::pos)) {
                Fixpipe<DstT, SrcT, CFG_NZ_UB>(dst, colLocal, quantTensor, params_);
