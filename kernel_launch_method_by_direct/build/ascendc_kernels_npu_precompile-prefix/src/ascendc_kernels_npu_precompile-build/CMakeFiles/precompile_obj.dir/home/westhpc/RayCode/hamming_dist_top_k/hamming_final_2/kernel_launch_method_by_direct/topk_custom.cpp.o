    [aicore] inline constexpr decltype(auto) cast_to_MatmulSubBlockInfo() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulSubBlockInfo> (*(static_cast<typename IMPL::MatmulSubBlockInfo*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulSubBlockInfo*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulSubBlockInfo() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulSubBlockInfo> (*(static_cast<const typename IMPL::MatmulSubBlockInfo*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulSubBlockInfo*>(static_cast<const IMPL*>(this))); } };

public:
