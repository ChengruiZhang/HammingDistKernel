    [aicore] inline ~CopyCubeOut() = default;

    template <bool enSequentialWrite = false, typename ScheduleContext = int>
    [aicore] inline void Copy(const GlobalTensor<DstT> &gm, const LocalTensor<SrcT> &co1Local, int curRow, int curCol,
        int32_t baseHeight, int32_t baseWidth, int32_t baseBlockHeight, int32_t baseBlockWidth,
        const ScheduleContext &context = 0)
    {
        CopyOut<A_TYPE, C_TYPE> copyOut;
        copyOut(gm, co1Local, curRow, curCol, baseHeight, baseWidth,
            cast_to_MatmulShapeTiling()->GetTiling().GetBaseM(),
            cast_to_MatmulShapeTiling()->GetTiling().GetBaseN(),
            cast_to_MatmulShapeInfo()->template GetOrgM<false>(),
            cast_to_MatmulShapeInfo()->template GetOrgN<false>(),
            cast_to_MatmulShapeInfo()->template GetOrgKc<false>());
    }

    template <bool enSequentialWrite = false, typename ScheduleContext = int>
    [aicore] inline void Copy(const LocalTensor<DstT> &co2Local, const LocalTensor<SrcT> &co1Local, int curRow, int curCol,
        int32_t baseHeight, int32_t baseWidth, int32_t baseBlockHeight, int32_t baseBlockWidth,
        const ScheduleContext &context = 0)
    {
        CopyOut<A_TYPE, C_TYPE> copyOut;
        copyOut(co2Local, co1Local, curRow, curCol, baseHeight, baseWidth,
            cast_to_MatmulShapeTiling()->GetTiling().GetBaseM(),
            cast_to_MatmulShapeTiling()->GetTiling().GetBaseN(),
            cast_to_MatmulShapeInfo()->template GetOrgM<false>(),
            cast_to_MatmulShapeInfo()->template GetOrgN<false>(),
            cast_to_MatmulShapeInfo()->template GetOrgKc<false>(),
            cast_to_MatmulSubBlockInfo()->GetSubBlockIdx());
    }
};

template <typename IMPL, class A_TYPE, class B_TYPE, class C_TYPE, const auto &MM_CFG, McgShfMode FIXPIPE_MODE,
    template <class INPUT_TYPE, class OUTPUT_TYPE, typename T = void> class CopyOut>
class CopyCubeOut<IMPL, A_TYPE, B_TYPE, C_TYPE, MM_CFG, FIXPIPE_MODE,
    enable_if_t<AscendC::Impl::Detail::IsQuantSenario<typename C_TYPE::T, typename A_TYPE::T>()>,
    CopyOut> {
    using DstT = typename C_TYPE::T;
    using SrcT = typename GetMmDstType<typename A_TYPE::T>::Type;

    [aicore] inline constexpr decltype(auto) cast_to_MatmulQuantProcessor() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulQuantProcessor> (*(static_cast<typename IMPL::MatmulQuantProcessor*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulQuantProcessor*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulQuantProcessor() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulQuantProcessor> (*(static_cast<const typename IMPL::MatmulQuantProcessor*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulQuantProcessor*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeInfo() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulShapeInfo> (*(static_cast<typename IMPL::MatmulShapeInfo*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulShapeInfo*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeInfo() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulShapeInfo> (*(static_cast<const typename IMPL::MatmulShapeInfo*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulShapeInfo*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeTiling() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulShapeTiling> (*(static_cast<typename IMPL::MatmulShapeTiling*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulShapeTiling*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeTiling() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulShapeTiling> (*(static_cast<const typename IMPL::MatmulShapeTiling*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulShapeTiling*>(static_cast<const IMPL*>(this))); } };

public:
    [aicore] inline CopyCubeOut() = default;
    [aicore] inline ~CopyCubeOut() = default;

    template <bool enSequentialWrite = false, typename ScheduleContext = int>
    [aicore] inline void Copy(const GlobalTensor<DstT> &gm, const LocalTensor<SrcT> &co1Local, int curRow, int curCol,
        int32_t baseHeight, int32_t baseWidth, int32_t baseBlockHeight, int32_t baseBlockWidth,
        const ScheduleContext &context = 0)
    {
        CopyOut<A_TYPE, C_TYPE> copyOut;
        if (cast_to_MatmulQuantProcessor()->IsPerChannelSenario()) {
            LocalTensor<uint64_t> quantTensor;
            cast_to_MatmulQuantProcessor()->CopyQuantTensor(quantTensor, curCol, baseWidth);
            copyOut(gm, co1Local, curRow, curCol, baseHeight, baseWidth,
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseM(),
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseN(),
                cast_to_MatmulShapeInfo()->template GetOrgM<false>(),
                cast_to_MatmulShapeInfo()->template GetOrgN<false>(),
                cast_to_MatmulShapeInfo()->template GetOrgKc<false>(), quantTensor);
            cast_to_MatmulQuantProcessor()->FreeQuantTensor(quantTensor);
        } else {
            copyOut(gm, co1Local, curRow, curCol, baseHeight, baseWidth,
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseM(),
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseN(),
                cast_to_MatmulShapeInfo()->template GetOrgM<false>(),
                cast_to_MatmulShapeInfo()->template GetOrgN<false>(),
                cast_to_MatmulShapeInfo()->template GetOrgKc<false>(),
                cast_to_MatmulQuantProcessor()->GetQuantScalarValue());
        }
    }
};
}
}
