    using TransT = typename A_TYPE::T;
    using BiasT = typename BIAS_TYPE::T;
    using DstT = typename C_TYPE::T;

public:
    using BASE_MODULE =
        AscendC::Impl::Detail::MatmulMDLSchedulerBase<IMPL, A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, POLICY_TYPE>;

    [aicore] inline bool ScheduleOnce(bool enPartialSum)
    {
        if (!BASE_MODULE::MoveNext()) {
            return false;
        }
        if (!enPartialSum) {
            cast_to_CubeOutBuffer()->AllocTensor();
        }
        cast_to_BiasScheduler()->SetBias(cast_to_BiasScheduler()->IsBias() && !enPartialSum);
        Compute(enPartialSum);
        return true;
    }

    [aicore] void GetResult(const GlobalTensor<DstT>& gm, uint8_t enAtomic = 0, bool enSequentialWrite = false)
    {
        static_assert(ToMatmulConfig(MM_CFG).scheduleType != ScheduleType::OUTER_PRODUCT, "Unsupported scheduleType");
        GetResultImpl(gm, enAtomic, enSequentialWrite);
    }

private:
    [aicore] constexpr auto OneBlockSize() const {
        return cast_to_MLoop()->GetBaseBlockShape() * cast_to_NLoop()->GetBaseBlockShape() * CUBE_MAX_SIZE;
    }

    template <typename L1In, typename GMOut>
    [aicore] void GetResultAlongNAxis(L1In& co1Local, GMOut& gm, bool enSequentialWrite = false)
    {
        auto loopModule = cast_to_NLoop();
        loopModule->InnerStart();
        do {
            auto offset = loopModule->GetInnerIdx() * OneBlockSize();
            if (enSequentialWrite) {
                cast_to_CopyCubeOut()
                    ->template Copy<true>(
                        gm, co1Local[offset], cast_to_MLoop()->GetInnerIdx(), cast_to_NLoop()->GetInnerIdx(),
                        cast_to_MLoop()->GetBaseShape(), cast_to_NLoop()->GetBaseShape(),
                        cast_to_MLoop()->GetBaseBlockShape(), cast_to_NLoop()->GetBaseBlockShape());
            } else {
                cast_to_CopyCubeOut()
                    ->template Copy<false>(
                        gm, co1Local[offset], cast_to_MLoop()->GetInnerIdx(), cast_to_NLoop()->GetInnerIdx(),
                        cast_to_MLoop()->GetBaseShape(), cast_to_NLoop()->GetBaseShape(),
                        cast_to_MLoop()->GetBaseBlockShape(), cast_to_NLoop()->GetBaseBlockShape());
            }
        } while (loopModule->InnerNext());
    }

    [aicore] void GetResultImpl(const GlobalTensor<DstT>& gm, uint8_t enAtomic, bool enSequentialWrite)
    {
        if constexpr (C_TYPE::format != CubeFormat::ND && C_TYPE::format != CubeFormat::ND_ALIGN &&
            C_TYPE::format != CubeFormat::NZ && C_TYPE::format != CubeFormat::COLUMN_MAJOR) {

                                                                                          ;
        }

        auto co1Local = cast_to_CubeOutBuffer()->GetTensor();
        cast_to_CubeOutBuffer()->EnQue(co1Local);
        cast_to_CubeOutBuffer()->DeQue();
        BASE_MODULE::SetAtomic(enAtomic);
        GetResultAlongNAxis(co1Local, gm);
        BASE_MODULE::ClearAtomic(enAtomic);
        cast_to_CubeOutBuffer()->FreeTensor(co1Local);
    }

    [aicore] void ComputeTilesAlongNAxis(int32_t kOuterIdx, bool enPartialSum = false)
    {
        bool isATranspose = cast_to_MatmulShapeInfo()->IsTransposeA();
        bool isBTranspose = cast_to_MatmulShapeInfo()->IsTransposeB();

        auto loopModule = cast_to_NLoop();
        loopModule->InnerStart();

        auto aL1 = BASE_MODULE::InitSplitAParams();
        do {
            auto bL1 = BASE_MODULE::InitSplitBParams();

            cast_to_KLoop()->InnerStart();
            LocalTensor<TransT> a1;
            LocalTensor<TransT> b1;
            BASE_MODULE::CopyIn(a1, b1);
            bool sL0CInit = false;
            bool sL0CLast = false;
            BASE_MODULE::SplitPrepare(enPartialSum, isATranspose, isBTranspose, aL1, bL1, sL0CInit, sL0CLast);


            SplitBias(bL1.axisL0Len);

            int32_t kL1Stride = cast_to_KLoop()->GetBaseBlockShape() * BASE_MODULE::c0Size_;

            cast_to_KLoop()->InnerStart();
            auto offset = loopModule->GetInnerIdx() * OneBlockSize();
            do {

                ComputeKDB(a1, b1, aL1, bL1, offset, isATranspose, isBTranspose, sL0CInit, sL0CLast);
                aL1.kAxisL1Offset += kL1Stride;
                bL1.kAxisL1Offset += kL1Stride;
            } while (cast_to_KLoop()->InnerNext());

            BASE_MODULE::DoPreloadAWait();
        } while (loopModule->InnerNext());
    }

    [aicore] inline void SplitBias(const int32_t dataLen)
    {
        auto bias = cast_to_BiasScheduler()->CopyIn(cast_to_NLoop()->GetBaseShape(), 1,
            cast_to_NLoop()->GetInnerIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetBaseN());
        cast_to_BiasScheduler()->SplitLoad(bias, dataLen);
        cast_to_BiasScheduler()->Free(bias);
    }

    [aicore] inline void Compute(bool enPartialSum = false)
    {
        int32_t curKaOuterIdx = 0, curKbOuterIdx = 0;
        cast_to_KLoop()->OuterStart();
        do {
            ComputeTilesAlongNAxis(cast_to_KLoop()->GetOuterIdx(), enPartialSum);
            BASE_MODULE::ClearL1BufferCache(curKaOuterIdx, curKbOuterIdx);
        } while (cast_to_KLoop()->OuterNext());


        BASE_MODULE::ResetCopyInBuffer();
    }

    [aicore] inline void ComputeKDB(const LocalTensor<TransT>& a1, const LocalTensor<TransT>& b1,
        const SplitParams& aL0Params, const SplitParams& bL0Params, const int32_t offset,
        const bool isATranspose, const bool isBTranspose, const bool sL0CInit, const bool sL0CLast)
    {
        cast_to_TBufPoolL0()->Allocate();
        LocalTensor<TransT> a2 = BASE_MODULE::SplitA(a1, aL0Params, isATranspose);
        LocalTensor<TransT> b2 = BASE_MODULE::SplitB(b1, bL0Params, isBTranspose);
        cast_to_TBufPoolL0()->EnQue();
        cast_to_TBufPoolL0()->DeQue();
        BASE_MODULE::CubeCompute(cast_to_CubeOutBuffer()->GetTensor()[offset], a2, b2, aL0Params.axisL0Len,
            bL0Params.axisL0Len, cast_to_KLoop()->GetBaseShape(), isATranspose, isBTranspose, sL0CInit, sL0CLast);
        cast_to_TBufPoolL0()->Free();
        cast_to_BiasScheduler()->Free();
    }
};

}
}
