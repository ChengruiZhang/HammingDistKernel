namespace Impl {
namespace Detail {





template <typename IMPL, class A_TYPE, class B_TYPE, class C_TYPE, const auto &MM_CFG, typename = void>
class PartialOutUtils
{
public:




    template <class T>
    [aicore] inline void SetWorkspace(__attribute__((cce_global)) const T* addr) {}




    [aicore] inline void CopyOut() {}





    [aicore] inline void Destroy() {}
};

template <typename IMPL, class A_TYPE, class B_TYPE, class C_TYPE, const auto &MM_CFG>
class PartialOutUtils<IMPL, A_TYPE, B_TYPE, C_TYPE, MM_CFG, enable_if_t<ToMatmulConfig(MM_CFG).isPartialOutput>>
{
    [aicore] inline constexpr decltype(auto) cast_to_MLoop() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MLoop> (*(static_cast<typename IMPL::MLoop*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MLoop*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MLoop() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MLoop> (*(static_cast<const typename IMPL::MLoop*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MLoop*>(static_cast<const IMPL*>(this))); } };
