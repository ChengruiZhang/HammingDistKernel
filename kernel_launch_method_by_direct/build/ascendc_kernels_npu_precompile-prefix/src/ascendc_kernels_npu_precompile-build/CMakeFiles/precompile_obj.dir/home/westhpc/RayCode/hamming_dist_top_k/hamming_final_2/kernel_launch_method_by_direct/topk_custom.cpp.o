template <class T, class... Args> [aicore] static T* GetCurTiling(T* t, Args&&... b)
{
    return t;
}

template <class T, class... Args>
[aicore] inline void InitCurObjSkip(AscendC::TPipe* tpipe, T* a,
    Args&&... b)
{
    InitCurObj(tpipe, b...);
}

template <class T, class... Args>
[aicore] inline void InitCurObj(AscendC::TPipe* tpipe, T& a, Args&&... b)
{
                                                         ;
    if constexpr (sizeof...(b) == 0) {
        SetTPipe(a, tpipe);
    } else {
        auto tiling = GetCurTiling(b...);
        a.SetSubBlockIdx(0);
        a.Init(tiling, tpipe);
        if constexpr (sizeof...(b) > 1) {
            InitCurObjSkip(tpipe, b...);
        }
    }
}
