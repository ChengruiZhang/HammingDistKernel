    using L0cT = typename GetMmDstType<typename A_TYPE::T>::Type;

public:
    using BASE_MODULE = AscendC::Impl::Detail::MatmulSchedulerBase<IMPL, A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, POLICY_TYPE>;
    [aicore] inline void Init(const TCubeTiling *__restrict cubeTiling, TPipe *tpipe)
    {
        BASE_MODULE::Init(cubeTiling, tpipe);
        if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload > 0) {
            if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload == PRELOAD_M) {
                                                                                                                         ;
            } else if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload == PRELOAD_N) {
                                                                                                                         ;
            }
            const auto& tiling = cast_to_MatmulShapeTiling()->GetTiling();
            uint32_t cacheA1Size = tiling.GetStepM() * tiling.GetStepKa();
            cacheA1Factor_ = (tiling.GetDepthA1() / cacheA1Size - 1) & 1;
            uint32_t cacheB1Size = tiling.GetStepN() * tiling.GetStepKb();
            cacheB1Factor_ = (tiling.GetDepthB1() / cacheB1Size - 1) & 1;
        }
    }

    [aicore] inline void Reset()
    {
        isFirstIter_ = true;
    }
protected:
    [aicore] inline bool MoveNext()
    {
        if (__builtin_expect(!!(isFirstIter_), 0)) {
            return MoveOnFirstIterate();
        } else {
            if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::UNDEF) {
                if (__builtin_expect(!!(cast_to_MatmulShapeTiling()->GetTiling().GetIterateOrder() == static_cast<int>(IterateOrder::ORDER_M)), 1)) {
                    return MoveOnIterateOrderM();
                } else {




                      ;
                    return MoveOnIterateOrderN();
                }
            } else if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_M) {
                return MoveOnIterateOrderM();
            } else {
                return MoveOnIterateOrderN();
            }
        }
    }

    [aicore] inline bool MoveOnFirstIterate()
    {
        isFirstIter_ = false;
        cast_to_MLoop()->OuterStart();
        cast_to_MLoop()->InnerStart();
        cast_to_NLoop()->OuterStart();
        cast_to_NLoop()->InnerStart();
        return true;
    }

    [aicore] inline bool MoveOnIterateOrderM()
    {

        if (!cast_to_NLoop()->InnerNext()) {
            cast_to_NLoop()->InnerStart();

            if (!cast_to_MLoop()->InnerNext()) {
                if constexpr (!PhyPosIsL1OrUB<MM_CFG>(A_TYPE::pos)) {
                    if ((cast_to_KLoop()->IsAKL1FullLoad() && !cast_to_MLoop()->IsAML1FullLoad()) ||
                        (cast_to_MLoop()->IsLastOuterIter() && cast_to_NLoop()->IsLastOuterIter())) {
                        cast_to_CopyCubeInA()->ClearLoadData();
                    }
                }


                if (!cast_to_MLoop()->OuterNext()) {
                    if constexpr (!PhyPosIsL1OrUB<MM_CFG>(B_TYPE::pos)) {
                        if ((cast_to_KLoop()->IsBKL1FullLoad() && !cast_to_NLoop()->IsBNL1FullLoad()) ||
                            (cast_to_MLoop()->IsLastOuterIter() && cast_to_NLoop()->IsLastOuterIter())) {
                            cast_to_CopyCubeInB()->ClearLoadData();
                        }
                    }
                    cast_to_MLoop()->OuterStart();
                    cast_to_MLoop()->InnerStart();

                    if (!cast_to_NLoop()->OuterNext()) {
                        return false;
                    }

                    cast_to_NLoop()->InnerStart();
                }
            }
        }
        return true;
    }

    [aicore] inline bool MoveOnIterateOrderN()
    {

        if (!cast_to_MLoop()->InnerNext()) {
            cast_to_MLoop()->InnerStart();

            if (!cast_to_NLoop()->InnerNext()) {
                if constexpr (!PhyPosIsL1OrUB<MM_CFG>(B_TYPE::pos)) {
                    if ((cast_to_KLoop()->IsBKL1FullLoad() && !cast_to_NLoop()->IsBNL1FullLoad()) ||
                        (cast_to_MLoop()->IsLastOuterIter() && cast_to_NLoop()->IsLastOuterIter())) {
                        cast_to_CopyCubeInB()->ClearLoadData();
                    }
                }


                if (!cast_to_NLoop()->OuterNext()) {
                    if constexpr (!PhyPosIsL1OrUB<MM_CFG>(A_TYPE::pos)) {
                        if ((cast_to_KLoop()->IsAKL1FullLoad() && !cast_to_MLoop()->IsAML1FullLoad()) ||
                            (cast_to_MLoop()->IsLastOuterIter() && cast_to_NLoop()->IsLastOuterIter())) {
                            cast_to_CopyCubeInA()->ClearLoadData();
                        }
                    }
                    cast_to_NLoop()->OuterStart();
                    cast_to_NLoop()->InnerStart();

                    if (!cast_to_MLoop()->OuterNext()) {
                        return false;
                    }

                    cast_to_MLoop()->InnerStart();
                }
            }
        }
        return true;
    }

    [aicore] inline void CopyIn(LocalTensor<TransAT>& a1, LocalTensor<TransBT>& b1)
    {
        a1 = cast_to_CopyCubeInA()->LoadData(cast_to_MLoop()->GetInnerIdx(), cast_to_KLoop()->GetInnerStartIdx(),
            cast_to_MLoop()->GetTileShape(), cast_to_KLoop()->GetTileShapeA());
        b1 = cast_to_CopyCubeInB()->LoadData(cast_to_KLoop()->GetInnerStartIdx(), cast_to_NLoop()->GetInnerIdx(),
            cast_to_KLoop()->GetTileShapeB(), cast_to_NLoop()->GetTileShape());

        if constexpr (MatmulFeatureTrait<MM_CFG>::IsSupportUBToL1Singleshape()) {
            cast_to_MatmulCrossCoreSync()->WaitL1Ready();
        }

        DoPreloadLoad();
    }

    [aicore] inline void SplitPrepare(const bool enPartialSum, const bool isATranspose, const bool isBTranspose,
        SplitParams& aL0Params, SplitParams& bL0Params, bool& sL0CInit, bool& sL0CLast)
    {
        UpdateSplitParams(aL0Params, bL0Params);
        UpdateComputeParams(enPartialSum, sL0CInit, sL0CLast);
        cast_to_LoadToA2()->Prepare(isATranspose, aL0Params.kAxisL1Len, aL0Params.axisL1Len);
        cast_to_LoadToB2()->Prepare(isBTranspose, bL0Params.kAxisL1Len);
    }

    [aicore] inline LocalTensor<TransAT> SplitA(const LocalTensor<TransAT>& a1,
        const SplitParams& aL0Params, const bool isATranspose)
    {
        if constexpr (DoMatmulSpecialMDL(MM_CFG) || MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
            LocalTensor<TransAT> a2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::A2, TransAT>();
            cast_to_LoadToA2()->Load(a2, a1, aL0Params.axisL1Len, aL0Params.kAxisL1Len, aL0Params.axisL0Len,
