    [aicore] inline constexpr decltype(auto) cast_to_CopyCubeInParams() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG> > (*(static_cast<typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_CopyCubeInParams() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG> > (*(static_cast<const typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::template CopyCubeInParams<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_DataCopyUtils() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::template DataCopyUtils<INPUT_TYPE::TAG> > (*(static_cast<typename IMPL::template DataCopyUtils<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::template DataCopyUtils<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_DataCopyUtils() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::template DataCopyUtils<INPUT_TYPE::TAG> > (*(static_cast<const typename IMPL::template DataCopyUtils<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::template DataCopyUtils<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this))); } };
    using TransT = typename INPUT_TYPE::TRANS_T;

public:
    using BASE_MODULE = AscendC::Impl::Detail::CopyCubeInMDLBase<IMPL, MM_CFG, INPUT_TYPE>;
    [aicore] inline CopyCubeIn() = default;
    [aicore] inline ~CopyCubeIn() = default;

    template <typename ScheduleContext = int>
    [aicore] inline LocalTensor<TransT> LoadData(
        int32_t curRow, int32_t curCol, int32_t tileHeight, int32_t tileWidth, const ScheduleContext& context = {})
    {
        LocalTensor<TransT> l1;
        int32_t posL1 = BASE_MODULE::GetIterIndex(curRow, curCol);
        int32_t bufferPos = cast_to_CopyCubeInParams()->GetBufferPos();
        if (isFirstIter_) {
            isFirstIter_ = false;
            l1 = cast_to_CubeInBuffer()->AllocTensor(bufferPos);
            cast_to_DataCopyUtils()->CopyTileToCube(l1, curRow, curCol, tileHeight, tileWidth);
            cast_to_CubeInBuffer()->EnQue(l1);
            cast_to_CubeInBuffer()->DeQue();
        } else {
            l1 = cast_to_CubeInBuffer()->GetBuffer(posL1, bufferPos);
        }
        return l1;
    }

private:
    bool isFirstIter_ = true;
};
}
}
