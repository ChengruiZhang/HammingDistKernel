    int32_t outerIdx_ {0};
    int32_t innerStartIdx_;

    int32_t innerIdx_ {0};
    bool isA1KFullLoad_, isB1KFullLoad_;

    constexpr static int32_t c0Size_ = AuxGetC0Size<typename A_TYPE::T>();
};

}
