        hammingLastRowUB.FreeTensor(hammingLastRow);
        hammingSumUB.FreeTensor(hammingSum);
        hammingReduceUB.FreeTensor(hammingReduce);
        reduceSumWorkSpaceUB.FreeTensor(reduceSumWorkSpace);


