        cast_to_CopyCubeInB()->ClearLoadData(b1);
    }

    [aicore] inline void ComputeMultiIter(bool enPartialSum)
    {

        SplitParams aL0Params = BASE_MODULE::InitSplitAParams();
        SplitParams bL0Params = BASE_MODULE::InitSplitBParams();


        cast_to_KLoop()->OuterStart();
        do {
            int32_t kOuterIdx = cast_to_KLoop()->GetOuterIdx();

            LocalTensor<TransAT> a1 = cast_to_CopyCubeInA()->LoadData(
                cast_to_MLoop()->GetInnerIdx(), kOuterIdx,
                cast_to_MLoop()->GetTileShape(), cast_to_KLoop()->GetTileShapeA());
            LocalTensor<TransBT> b1 = cast_to_CopyCubeInB()->LoadData(
                kOuterIdx, cast_to_NLoop()->GetInnerIdx(),
                cast_to_KLoop()->GetTileShapeB(), cast_to_NLoop()->GetTileShape());

            if constexpr (MatmulFeatureTrait<MM_CFG>::IsSupportUBToL1Singleshape()) {
                cast_to_MatmulCrossCoreSync()->WaitL1Ready();
            }


            bool sL0CInit = false;
            bool sL0CLast = false;
            BASE_MODULE::UpdateComputeParams(enPartialSum, sL0CInit, sL0CLast);
            BASE_MODULE::SplitBias(bL0Params.axisL0Len);
            bool isATranspose = cast_to_MatmulShapeInfo()->IsTransposeA();
            bool isBTranspose = cast_to_MatmulShapeInfo()->IsTransposeB();
            BASE_MODULE::SplitPrepare(isATranspose, isBTranspose, aL0Params, bL0Params);

            cast_to_TBufPoolL0()->Allocate();
            LocalTensor<TransAT> a2 = SplitA(a1, aL0Params, isATranspose);
            LocalTensor<TransBT> b2 = SplitB(b1, bL0Params, isBTranspose);
            cast_to_TBufPoolL0()->EnQue();
            cast_to_TBufPoolL0()->DeQue();

            CubeCompute(cast_to_CubeOutBuffer()->GetTensor(), a2, b2, aL0Params.axisL0Len, bL0Params.axisL0Len,
                cast_to_KLoop()->GetTileShapeA(), isATranspose, isBTranspose, enPartialSum, sL0CInit, sL0CLast);

            cast_to_CopyCubeInA()->ClearLoadData(a1, cast_to_MLoop()->GetInnerIdx(), kOuterIdx);
            cast_to_CopyCubeInB()->ClearLoadData(b1, kOuterIdx, cast_to_NLoop()->GetInnerIdx());
        } while (cast_to_KLoop()->OuterNext());
    }

private:

    [aicore] inline LocalTensor<TransAT> SplitA(const LocalTensor<TransAT>& a1,
        const SplitParams& aL0Params, const bool isATranspose)
    {
        auto posA = cast_to_MLoop()->GetInnerIdx() * cast_to_KLoop()->GetTotalIter() + cast_to_KLoop()->GetInnerIdx();
        LocalTensor<TransAT> a2;

        if (!(cast_to_TBufPoolL0()->template Hit<TPosition::A2>(posA))) {
            a2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::A2, TransAT>();
            cast_to_LoadToA2()->Load(a2, a1, aL0Params.axisL1Len, aL0Params.kAxisL1Len,
                aL0Params.axisL0Len, cast_to_KLoop()->GetTileShapeA(), aL0Params.axisL1Offset,
                aL0Params.kAxisL1Offset, isATranspose);
        } else {
            a2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::A2, TransAT>();
        }
        return a2;
    }

    [aicore] inline LocalTensor<TransBT> SplitB(const LocalTensor<TransBT>& b1,
        const SplitParams& bL0Params, const bool isBTranspose)
    {
        auto posB = cast_to_NLoop()->GetInnerIdx() * cast_to_KLoop()->GetTotalIter() + cast_to_KLoop()->GetInnerIdx();
        LocalTensor<TransBT> b2;
        if (!(cast_to_TBufPoolL0()->template Hit<TPosition::B2>(posB))) {
            b2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();
            cast_to_LoadToB2()->Load(b2, b1, bL0Params.axisL1Len, bL0Params.kAxisL1Len,
                bL0Params.axisL0Len, cast_to_KLoop()->GetTileShapeA(), bL0Params.axisL1Offset,
                bL0Params.kAxisL1Offset, isBTranspose);
        } else {
            b2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();
        }
        return b2;
    }

    [aicore] inline void CubeCompute(const LocalTensor<L0cT>& cMatrix, const LocalTensor<TransAT>& a2,
        const LocalTensor<TransBT>& b2, const uint16_t madM, const uint16_t madN, const uint16_t madK,
        const bool isATranspose, const bool isBTranspose, const bool enPartialSum, const bool sL0CInit, const bool sL0CLast)
