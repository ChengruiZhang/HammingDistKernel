    [aicore] inline void SetSingleShapeFromTiling(int32_t singleShape)
    {
        totalIter_ = Ceil(singleShape, cast_to_MatmulShapeTiling()->GetTiling().GetBaseN());
        tailBaseShape_ = singleShape % cast_to_MatmulShapeTiling()->GetTiling().GetBaseN();
        if (tailBaseShape_ == 0) {
            tailBaseShape_ = cast_to_MatmulShapeTiling()->GetTiling().GetBaseN();
        }
    }

    [aicore] inline void UpdateOuterParams()
    {
        if constexpr (IsBasicN(MM_CFG)) {
            innerIter_ = 1;
        } else {
            innerIter_ =
                (totalIter_ - innerStartIdx_) > static_cast<uint32_t>(cast_to_MatmulShapeTiling()->GetTiling().GetStepN()) ?
                cast_to_MatmulShapeTiling()->GetTiling().GetStepN() : (totalIter_ - innerStartIdx_);
