                FIXPIPE_MODE == McgShfMode::SINGLE_DST_MODE) {
                fixpipe.SetMcgShfMode(McgShfMode::DUAL_DST_SPLIT_M);
            } else {
                fixpipe.SetMcgShfMode(FIXPIPE_MODE);
            }
        }
    }
