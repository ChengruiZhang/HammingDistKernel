            cast_to_MatmulCrossCoreSync()->WaitL1Ready();
        }

        BASE_MODULE::SplitBias(bL0Params.axisL0Len);


        bool isBTranspose = cast_to_MatmulShapeInfo()->IsTransposeB();
        bool isATranspose = cast_to_MatmulShapeInfo()->IsTransposeA();

        BASE_MODULE::SplitPrepare(isATranspose, isBTranspose, aL0Params, bL0Params);
        cast_to_TBufPoolL0()->Allocate();
        LocalTensor<TransAT> a2 = SplitA(a1, aL0Params, isATranspose);
        LocalTensor<TransBT> b2 = SplitB(b1, bL0Params, isBTranspose);
        cast_to_TBufPoolL0()->EnQue();
        cast_to_TBufPoolL0()->DeQue();


        CubeCompute(cast_to_CubeOutBuffer()->GetTensor(), a2, b2, aL0Params.axisL0Len, bL0Params.axisL0Len,
            cast_to_KLoop()->GetTileShapeA(), isATranspose, isBTranspose, enPartialSum, !enPartialSum, true);

