        }
    }

    [aicore] inline void UpdateInnerParams(AscendC::Std::integral_constant<PolicyType, PolicyType::MATMUL_NBUFFER_33>)
    {
        if constexpr (IsStaticPaddingEnable(MM_CFG)) {
            baseShape_ = cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
        } else {
            baseShape_ = (innerIdx_ == innerIter_ -1) ? tailK_ :
                            cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
        }
        baseBlockShape_ = Ceil(baseShape_, c0Size_);
    }

protected:
    int32_t tailK_;
    int32_t tailStepKa_;
    int32_t tailStepKb_;
    int32_t minStepK_;
    int32_t baseSize_;
    int32_t innerTailK_;

    int32_t tileShapeA_;
    int32_t tileShapeB_;
    int32_t tileBlockShapeA_;
    int32_t tileBlockShapeB_;
    int32_t kaStepFactor_;
    int32_t kbStepFactor_;

