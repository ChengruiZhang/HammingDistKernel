    [aicore] inline constexpr decltype(auto) cast_to_LoadToB2() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::LoadToB2> (*(static_cast<typename IMPL::LoadToB2*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::LoadToB2*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_LoadToB2() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::LoadToB2> (*(static_cast<const typename IMPL::LoadToB2*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::LoadToB2*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_TBufPoolL0() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::TBufPoolL0> (*(static_cast<typename IMPL::TBufPoolL0*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::TBufPoolL0*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_TBufPoolL0() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::TBufPoolL0> (*(static_cast<const typename IMPL::TBufPoolL0*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::TBufPoolL0*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_MmadCompute() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MmadCompute> (*(static_cast<typename IMPL::MmadCompute*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MmadCompute*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MmadCompute() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MmadCompute> (*(static_cast<const typename IMPL::MmadCompute*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MmadCompute*>(static_cast<const IMPL*>(this))); } };

    using TransAT = typename A_TYPE::T;
    using TransBT = typename decltype(GetTransBDataType<A_TYPE, B_TYPE, MM_CFG>())::T;
    using BiasT = typename BIAS_TYPE::T;
    using DstT = typename C_TYPE::T;
    using L0cT = typename GetMmDstType<typename A_TYPE::T>::Type;

public:
    using BASE_MODULE =
        AscendC::Impl::Detail::MatmulNormSchedulerBase<IMPL, A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, POLICY_TYPE>;

    [aicore] inline bool ScheduleOnce(bool enPartialSum)
    {
        if (!BASE_MODULE::MoveNext()) {
            return false;
        }
        if (!enPartialSum) {
            cast_to_CubeOutBuffer()->AllocTensor();
        }
        cast_to_BiasScheduler()->SetBias(!enPartialSum && cast_to_BiasScheduler()->IsBias());
        Compute(enPartialSum);
        return true;
    }

    [aicore] inline void Compute(bool enPartialSum)
    {
        if constexpr(ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_N) {
            ComputeMultiIterOrderN(enPartialSum);
        } else {
            ComputeMultiIterOrderM(enPartialSum);
        }
    }

    [aicore] inline void GetResult(const GlobalTensor<DstT>& gm, uint8_t enAtomic = 0, bool enSequentialWrite = false)
    {
        GetResultImpl(gm, enAtomic, enSequentialWrite);
    }

    [aicore] inline void GetResult(const LocalTensor<DstT>& co2Local, uint8_t enAtomic = 0,
        bool enSequentialWrite = false)
    {
        static_assert(ToMatmulConfig(MM_CFG).scheduleType != ScheduleType::OUTER_PRODUCT,
            "When scheduleType is OUTER_PRODUCT, GetResult function of LocalTensor output is not supported.");
    }

private:
    [aicore] inline void ComputeMultiIterOrderN(bool enPartialSum)
    {

        SplitParams aL0Params = BASE_MODULE::InitSplitAParams();
        SplitParams bL0Params = BASE_MODULE::InitSplitBParams();


        cast_to_KLoop()->OuterStart();
        do {
            int32_t kOuterIdx = cast_to_KLoop()->GetOuterIdx();

            LocalTensor<TransBT> b1 = cast_to_CopyCubeInB()->LoadData(
                kOuterIdx, cast_to_NLoop()->GetInnerIdx(),
                cast_to_KLoop()->GetTileShapeB(), cast_to_NLoop()->GetTileShape());

            BASE_MODULE::UpdateSplitParams(aL0Params, bL0Params);
            SplitBias(bL0Params.axisL0Len);
            bool isATranspose = cast_to_MatmulShapeInfo()->IsTransposeA();
            bool isBTranspose = cast_to_MatmulShapeInfo()->IsTransposeB();
            cast_to_LoadToB2()->Prepare(isBTranspose, bL0Params.kAxisL1Len);
            ComputeLoopM(b1, aL0Params, bL0Params, enPartialSum, kOuterIdx, isATranspose, isBTranspose);
            cast_to_BiasScheduler()->Free();

            cast_to_CopyCubeInB()->ClearLoadData(b1, kOuterIdx, cast_to_NLoop()->GetInnerIdx());
        } while (cast_to_KLoop()->OuterNext());
    }

    [aicore] inline void ComputeLoopM(const LocalTensor<TransBT>& b1, const SplitParams& aL0Params,
        const SplitParams& bL0Params, const bool enPartialSum, const int32_t kOuterIdx, const bool isATranspose, const bool isBTranspose)
    {
        bool sL0CInit = false;
        bool sL0CLast = false;
        BASE_MODULE::UpdateComputeParams(enPartialSum, sL0CInit, sL0CLast);
        uint32_t l0aDBLoop = cast_to_MLoop()->GetL0DBLoopNum();

        int32_t kL0Len = cast_to_KLoop()->GetTileShapeA();
        int dbUsedM = cast_to_MLoop()->GetTileShape();
        int mL1Len = aL0Params.axisL1Len;
        auto madMLen = aL0Params.axisL0Len;
        auto posB = cast_to_NLoop()->GetInnerIdx() * cast_to_KLoop()->GetTotalIter() + cast_to_KLoop()->GetInnerIdx();
        for (int dbInner = 0; dbInner < l0aDBLoop; dbInner++) {
            if (dbInner > 0) {
                if (cast_to_MLoop()->GetInnerIdx() + DB_NUM == cast_to_MLoop()->GetTotalIter()) {
                    dbUsedM = cast_to_MLoop()->GetTailShape();
                    mL1Len = CeilAlign(dbUsedM, BLOCK_CUBE);
                    madMLen = dbUsedM;
                    madMLen = BASE_MODULE::GetFixedMadM(madMLen);
                }
            }
            LocalTensor<TransAT> a1 = cast_to_CopyCubeInA()->LoadData(cast_to_MLoop()->GetInnerIdx() + dbInner,
                kOuterIdx, dbUsedM, cast_to_KLoop()->GetTileShapeA());

            auto& bufferPool = cast_to_TBufPoolL0()->Allocate();
            auto posA = (cast_to_MLoop()->GetInnerIdx() + dbInner) * cast_to_KLoop()->GetTotalIter() +
                cast_to_KLoop()->GetInnerIdx();
            LocalTensor<TransAT> a2 = SplitA(a1, aL0Params, posA, mL1Len, madMLen, kL0Len, isATranspose);
            LocalTensor<TransBT> b2 = SplitB(b1, bL0Params, posB, bL0Params.axisL1Len, bL0Params.axisL0Len, kL0Len, isBTranspose);
            bufferPool.EnQue();
            bufferPool.DeQue();

            CubeCompute(cast_to_CubeOutBuffer()->GetTensor()[
                dbInner * cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() *
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseN()], a2, b2, madMLen, bL0Params.axisL0Len,
                kL0Len, isATranspose, isBTranspose, enPartialSum, sL0CInit, sL0CLast);
            bufferPool.Free();
            cast_to_CopyCubeInA()->ClearLoadData(a1, cast_to_MLoop()->GetInnerIdx() + dbInner, kOuterIdx);
        }
    }

    [aicore] inline void ComputeMultiIterOrderM(bool enPartialSum)
    {

        SplitParams aL0Params = BASE_MODULE::InitSplitAParams();
        SplitParams bL0Params = BASE_MODULE::InitSplitBParams();


        cast_to_KLoop()->OuterStart();
        do {
            int32_t kOuterIdx = cast_to_KLoop()->GetOuterIdx();

            LocalTensor<TransAT> a1 = cast_to_CopyCubeInA()->LoadData(cast_to_MLoop()->GetInnerIdx(),
                kOuterIdx, cast_to_MLoop()->GetTileShape(), cast_to_KLoop()->GetTileShapeA());

            auto bias = SplitBias();
            bool isATranspose = cast_to_MatmulShapeInfo()->IsTransposeA();
            bool isBTranspose = cast_to_MatmulShapeInfo()->IsTransposeB();
            BASE_MODULE::SplitPrepare(isATranspose, isBTranspose, aL0Params, bL0Params);
            ComputeLoopN(a1, bias, aL0Params, bL0Params, enPartialSum, kOuterIdx, isATranspose, isBTranspose);
            cast_to_BiasScheduler()->Free(bias);
            cast_to_CopyCubeInA()->ClearLoadData(a1, cast_to_MLoop()->GetInnerIdx(), kOuterIdx);
        } while (cast_to_KLoop()->OuterNext());
    }

    [aicore] inline void ComputeLoopN(const LocalTensor<TransAT>& a1, LocalTensor<BiasT>& bias, const SplitParams& aL0Params,
        const SplitParams& bL0Params, const bool enPartialSum, const int32_t kOuterIdx, const bool isATranspose, const bool isBTranspose)
    {
        bool sL0CInit = false;
        bool sL0CLast = false;
        BASE_MODULE::UpdateComputeParams(enPartialSum, sL0CInit, sL0CLast);

        uint32_t l0bDBLoop = cast_to_NLoop()->GetL0DBLoopNum();

        int32_t kL0Len = cast_to_KLoop()->GetTileShapeA();

        int dbUsedN = cast_to_NLoop()->GetTileShape();
        int nL1Len = bL0Params.axisL1Len;
        int madNLen = bL0Params.axisL0Len;
        auto posA = cast_to_MLoop()->GetInnerIdx() * cast_to_KLoop()->GetTotalIter() + cast_to_KLoop()->GetInnerIdx();
        for (int dbInner = 0; dbInner < l0bDBLoop; dbInner++) {
            if (dbInner > 0) {
                if (cast_to_NLoop()->GetInnerIdx() + DB_NUM == cast_to_NLoop()->GetTotalIter()) {
                    dbUsedN = cast_to_NLoop()->GetTailShape();
                    nL1Len = CeilAlign(dbUsedN, BLOCK_CUBE);
                    madNLen = dbUsedN;
                }
            }
            LocalTensor<TransBT> b1 = cast_to_CopyCubeInB()->LoadData(kOuterIdx,
                cast_to_NLoop()->GetInnerIdx() + dbInner, cast_to_KLoop()->GetTileShapeB(), dbUsedN);


            auto& bufferPool = cast_to_TBufPoolL0()->Allocate();
            auto posB = (cast_to_NLoop()->GetInnerIdx() + dbInner) * cast_to_KLoop()->GetTotalIter() +
                cast_to_KLoop()->GetInnerIdx();
            LocalTensor<TransAT> a2 = SplitA(a1, aL0Params, posA, aL0Params.axisL1Len, aL0Params.axisL0Len, kL0Len, isATranspose);
            LocalTensor<TransBT> b2 = SplitB(b1, bL0Params, posB, nL1Len, madNLen, kL0Len, isBTranspose);
            bufferPool.EnQue();
            bufferPool.DeQue();

            cast_to_BiasScheduler()->SplitLoad(bias, dbUsedN, dbInner * bL0Params.axisL0Len);

            CubeCompute(cast_to_CubeOutBuffer()->GetTensor()[
                dbInner * cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() *
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseN()],
                a2, b2, aL0Params.axisL0Len, madNLen, kL0Len, isATranspose, isBTranspose, enPartialSum, sL0CInit, sL0CLast);
            bufferPool.Free();
            cast_to_BiasScheduler()->Free();
            cast_to_CopyCubeInB()->ClearLoadData(b1, kOuterIdx, cast_to_NLoop()->GetInnerIdx() + dbInner);
        }
    }

    [aicore] inline LocalTensor<BiasT> SplitBias(const int32_t dataLen = 0)
    {
        if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_N) {
            LocalTensor<BiasT> bias = cast_to_BiasScheduler()->CopyIn(cast_to_NLoop()->GetBaseShape(), 1,
                cast_to_NLoop()->GetInnerIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetBaseN());
            cast_to_BiasScheduler()->SplitLoad(bias, dataLen);
            cast_to_BiasScheduler()->Free(bias);
            return {};
        } else {
             return cast_to_BiasScheduler()->CopyIn(cast_to_NLoop()->GetBaseShape(), 1,
                cast_to_NLoop()->GetInnerIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetBaseN());
        }
    }

    [aicore] inline void CubeCompute(const LocalTensor<L0cT>& cMatrix, const LocalTensor<TransAT>& a2,
        const LocalTensor<TransBT>& b2, const uint16_t madM, const uint16_t madN, const uint16_t madK,
        const bool isATranspose, const bool isBTranspose, const bool enPartialSum, const bool sL0CInit, const bool sL0CLast)
    {
        uint8_t unitFlag = cast_to_MatmulUnitFlag()->GetUnitFlag(sL0CLast);
        bool isBias;
        bool cmatrixInitVal;
        bool cmatrixSource;
        BASE_MODULE::UpdateBiasParams(enPartialSum, sL0CInit, cmatrixSource, cmatrixInitVal, isBias);
        cast_to_MmadCompute()->Compute(cMatrix, a2, b2, madM, madK, madN,
            isATranspose, isBTranspose, unitFlag, cmatrixSource, cmatrixInitVal, isBias);
    }

    [aicore] inline LocalTensor<TransAT> SplitA(const LocalTensor<TransAT>& a1, const SplitParams& aL0Params,
    const int32_t posA, const uint16_t mL1Len, const uint16_t madMLen, const uint16_t kL0Len, const bool isATranspose)
    {

        LocalTensor<TransAT> a2;
        if (!(cast_to_TBufPoolL0()->template Hit<TPosition::A2>(posA))) {
            a2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::A2, TransAT>();
            if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_N) {
                cast_to_LoadToA2()->Prepare(isATranspose, aL0Params.kAxisL1Len, mL1Len);
            }
            cast_to_LoadToA2()->Load(a2, a1, mL1Len, aL0Params.kAxisL1Len,
                madMLen, kL0Len, aL0Params.axisL1Offset, aL0Params.kAxisL1Offset, isATranspose);
        } else {
            a2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::A2, TransAT>();
        }
        return a2;
    }

    [aicore] inline LocalTensor<TransBT> SplitB(const LocalTensor<TransBT>& b1, const SplitParams& bL0Params,
    const int32_t posB, const uint16_t nL1Len, const uint16_t madNLen, const uint16_t kL0Len, const bool isBTranspose)
    {
        LocalTensor<TransBT> b2;
        if (!(cast_to_TBufPoolL0()->template Hit<TPosition::B2>(posB))) {
            b2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();
            cast_to_LoadToB2()->Load(b2, b1, nL1Len, bL0Params.kAxisL1Len,
                madNLen, kL0Len, bL0Params.axisL1Offset, bL0Params.kAxisL1Offset, isBTranspose);
        } else {
            b2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();
        }
        return b2;
    }

    [aicore] inline void GetResultImpl(const GlobalTensor<DstT>& gm, uint8_t enAtomic, bool enSequentialWrite)
    {
        auto co1Local = cast_to_CubeOutBuffer()->GetTensor();
        cast_to_CubeOutBuffer()->EnQue(co1Local);
        cast_to_CubeOutBuffer()->DeQue();
        int32_t co1Offset = cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() *
            cast_to_MatmulShapeTiling()->GetTiling().GetBaseN();
        int32_t baseHeight = cast_to_MLoop()->GetBaseShape();
        int32_t baseWidth = cast_to_NLoop()->GetBaseShape();
        int32_t baseBlockHeight = cast_to_MLoop()->GetBaseBlockShape();
        int32_t baseBlockWidth = cast_to_NLoop()->GetBaseBlockShape();
        if (cast_to_NLoop()->GetL0DBLoopNum() > 1) {
            FixpipeL0CToGm(gm, co1Local, cast_to_MLoop()->GetInnerIdx(), cast_to_NLoop()->GetInnerIdx(),
                enAtomic, enSequentialWrite, baseHeight, baseWidth, baseBlockHeight, baseBlockWidth);
            if (cast_to_NLoop()->GetInnerIdx() + DB_NUM == cast_to_NLoop()->GetTotalIter()) {
                baseWidth = cast_to_NLoop()->GetTailShape();
                baseBlockWidth = Ceil(baseWidth, BLOCK_CUBE);
            }
            FixpipeL0CToGm(gm, co1Local[co1Offset],
                cast_to_MLoop()->GetInnerIdx(), cast_to_NLoop()->GetInnerIdx() + 1,
                enAtomic, enSequentialWrite, baseHeight, baseWidth, baseBlockHeight, baseBlockWidth);
        } else if (cast_to_MLoop()->GetL0DBLoopNum() > 1) {
            FixpipeL0CToGm(gm, co1Local,
                cast_to_MLoop()->GetInnerIdx(), cast_to_NLoop()->GetInnerIdx(),
                enAtomic, enSequentialWrite, baseHeight, baseWidth, baseBlockHeight, baseBlockWidth);
            if (cast_to_MLoop()->GetInnerIdx() + DB_NUM == cast_to_MLoop()->GetTotalIter()) {
                baseHeight = cast_to_MLoop()->GetTailShape();
                baseBlockHeight = Ceil(baseHeight, BLOCK_CUBE);
            }
            FixpipeL0CToGm(gm, co1Local[co1Offset],
                cast_to_MLoop()->GetInnerIdx() + 1, cast_to_NLoop()->GetInnerIdx(),
                enAtomic, enSequentialWrite, baseHeight, baseWidth, baseBlockHeight, baseBlockWidth);
        } else {
            FixpipeL0CToGm(gm, co1Local, cast_to_MLoop()->GetInnerIdx(), cast_to_NLoop()->GetInnerIdx(),
                enAtomic, enSequentialWrite, baseHeight, baseWidth, baseBlockHeight, baseBlockWidth);
        }
        cast_to_CubeOutBuffer()->FreeTensor(co1Local);
    }

    [aicore] inline void FixpipeL0CToGm(const GlobalTensor<DstT>& gm, const LocalTensor<L0cT>& co1Local,
        int32_t curM, int32_t curN, uint8_t enAtomic, bool enSequentialWrite,
        int32_t baseHeight, int32_t baseWidth, int32_t baseBlockHeight, int32_t baseBlockWidth)
    {
        if constexpr (C_TYPE::format != CubeFormat::ND && C_TYPE::format != CubeFormat::ND_ALIGN &&
            C_TYPE::format != CubeFormat::NZ && C_TYPE::format != CubeFormat::COLUMN_MAJOR) {

                                                                                                                   ;
        }
        BASE_MODULE::SetAtomic(enAtomic);
        if (enSequentialWrite) {
            cast_to_CopyCubeOut()->template Copy<true>(gm, co1Local, curM, curN,
                baseHeight, baseWidth, baseBlockHeight, baseBlockWidth);
        } else {
            cast_to_CopyCubeOut()->template Copy<false>(gm, co1Local, curM, curN,
                baseHeight, baseWidth, baseBlockHeight, baseBlockWidth);
        }

        BASE_MODULE::ClearAtomic(enAtomic);
    }

private:
    constexpr static int32_t DB_NUM = 2;
};

}
}
