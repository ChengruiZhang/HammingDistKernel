    SoftmaxFlashV2M1NoUpdateBasicBlockProcess(srcBuffer, expSumTensor, maxTensor, srcBuffer, tmpBuffer, tiling);
    SoftMaxFlashV2M1CastIntrinsicsImpl(dstLocal, srcBuffer, tiling.splitSize);
