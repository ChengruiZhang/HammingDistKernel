     [aicore] inline int32_t GetOrgWidthAlign()
     {
         return Align<int32_t>(GetOrgWidth(), c0Size_);
     }

     [aicore] inline int32_t GetBaseSize()
     {
         if constexpr (INPUT_TYPE::format == CubeFormat::VECTOR && !(IsTypeOneOfV<SrcT, float> || IsNeedC0Align<SrcT>())) {
             return GetBaseWidth();
         } else {
             return GetBaseHeightAlign() * GetBaseWidthAlign();
         }
     }

     [aicore] inline int32_t GetOrgSize()
     {
         return GetOrgHeightAlign() * GetOrgWidthAlign();
     }
