    [aicore] DumpShapeMessageHead(uint32_t dimIn, uint32_t shapeIn[], uint32_t rsvIn = 0)
    {


          ;
        dim = dimIn;
        rsv = rsvIn;
        for (uint32_t idx = 0; idx < 8; ++idx) {
