    [aicore] inline CopyCubeOut() = default;

    template <bool enSequentialWrite = false, typename ScheduleContext = int>
    [aicore] inline void Copy(const GlobalTensor<DstT>& gm, const LocalTensor<SrcT>& co1Local, int32_t curRow,
