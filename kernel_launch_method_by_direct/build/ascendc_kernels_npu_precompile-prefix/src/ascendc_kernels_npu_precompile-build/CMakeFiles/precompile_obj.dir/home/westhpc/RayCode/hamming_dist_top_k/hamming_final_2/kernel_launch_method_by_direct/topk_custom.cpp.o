    [aicore] inline constexpr decltype(auto) cast_to_BiasScheduler() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::BiasScheduler> (*(static_cast<typename IMPL::BiasScheduler*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::BiasScheduler*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_BiasScheduler() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::BiasScheduler> (*(static_cast<const typename IMPL::BiasScheduler*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::BiasScheduler*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_CubeOutBuffer() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::CubeOutBuffer> (*(static_cast<typename IMPL::CubeOutBuffer*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::CubeOutBuffer*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_CubeOutBuffer() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::CubeOutBuffer> (*(static_cast<const typename IMPL::CubeOutBuffer*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::CubeOutBuffer*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_CopyCubeInA() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::CopyCubeInA> (*(static_cast<typename IMPL::CopyCubeInA*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::CopyCubeInA*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_CopyCubeInA() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::CopyCubeInA> (*(static_cast<const typename IMPL::CopyCubeInA*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::CopyCubeInA*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_CopyCubeInB() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::CopyCubeInB> (*(static_cast<typename IMPL::CopyCubeInB*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::CopyCubeInB*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_CopyCubeInB() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::CopyCubeInB> (*(static_cast<const typename IMPL::CopyCubeInB*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::CopyCubeInB*>(static_cast<const IMPL*>(this))); } };

public:
    using BASE_MODULE =
        AscendC::Impl::Detail::MatmulMDLSchedulerCommon<IMPL, A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG>;

    template <class T>
    [aicore] inline bool Schedule(const T& dst, uint8_t enAtomic = 0, bool enSequentialWrite = false)
    {
        const auto nLoop = cast_to_NLoop();
        const auto mLoop = cast_to_MLoop();
        for (nLoop->OuterStart(); !nLoop->OuterEnd(); nLoop->OuterNext()) {
            for (nLoop->InnerStart(); !nLoop->InnerEnd(); nLoop->InnerNext()) {
                for (mLoop->InnerStart(); !mLoop->InnerEnd(); mLoop->InnerNext()) {
                    cast_to_BiasScheduler()->SetBias(cast_to_BiasScheduler()->IsBias());
                    cast_to_CubeOutBuffer()->AllocTensor();
                    BASE_MODULE::ReduceK(false);
                    BASE_MODULE::GetResult(dst, enAtomic, enSequentialWrite);
                }
            }
            cast_to_CopyCubeInB()->ClearLoadData();
        }
        cast_to_CopyCubeInA()->Reset();
        return true;
    }
};

}
