    [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeInfo() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulShapeInfo> (*(static_cast<typename IMPL::MatmulShapeInfo*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulShapeInfo*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeInfo() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulShapeInfo> (*(static_cast<const typename IMPL::MatmulShapeInfo*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulShapeInfo*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_TBufPoolL0() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::TBufPoolL0> (*(static_cast<typename IMPL::TBufPoolL0*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::TBufPoolL0*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_TBufPoolL0() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::TBufPoolL0> (*(static_cast<const typename IMPL::TBufPoolL0*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::TBufPoolL0*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_BiasScheduler() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::BiasScheduler> (*(static_cast<typename IMPL::BiasScheduler*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::BiasScheduler*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_BiasScheduler() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::BiasScheduler> (*(static_cast<const typename IMPL::BiasScheduler*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::BiasScheduler*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_CubeOutBuffer() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::CubeOutBuffer> (*(static_cast<typename IMPL::CubeOutBuffer*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::CubeOutBuffer*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_CubeOutBuffer() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::CubeOutBuffer> (*(static_cast<const typename IMPL::CubeOutBuffer*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::CubeOutBuffer*>(static_cast<const IMPL*>(this))); } };

    using TransAT = typename A_TYPE::T;
    using TransBT = typename decltype(GetTransBDataType<A_TYPE, B_TYPE, MM_CFG>())::T;
    using BiasT = typename BIAS_TYPE::T;
    using DstT = typename C_TYPE::T;
    using L0cT = typename GetMmDstType<typename A_TYPE::T>::Type;

public:
    using BASE_MODULE =
        AscendC::Impl::Detail::MatmulMDLSchedulerCommon<IMPL, A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, POLICY_TYPE>;

    [aicore] inline bool ScheduleOnce(bool enPartialSum)
    {
        cast_to_BiasScheduler()->SetBias(cast_to_BiasScheduler()->IsBias() && !enPartialSum);
        if (!MoveNext()) {
            return false;
        }
        if (!enPartialSum) {
            cast_to_CubeOutBuffer()->AllocTensor();
        }
        PartialK(enPartialSum);
        return true;
    }

private:
    [aicore] inline bool MoveNext()
    {
        if (__builtin_expect(!!(BASE_MODULE::isFirstIter_), 0)) {
            cast_to_KLoop()->InnerStart();
            return BASE_MODULE::MoveOnFirstIterate();
        } else {
            if (cast_to_KLoop()->InnerNext()) {
                return true;
            }

            cast_to_KLoop()->InnerStart();
            if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::UNDEF) {
                if (__builtin_expect(!!(cast_to_MatmulShapeTiling()->GetTiling().GetIterateOrder() == static_cast<int>(IterateOrder::ORDER_M)), 1)) {

                    return BASE_MODULE::MoveOnIterateOrderM();
                } else {




                      ;
                    return BASE_MODULE::MoveOnIterateOrderN();
                }
            } else if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_M) {
                return BASE_MODULE::MoveOnIterateOrderM();
            } else {
                return BASE_MODULE::MoveOnIterateOrderN();
            }
        }
    }

    [aicore] inline void PartialK(bool enPartialSum)
    {
        PartialKMultiIter(enPartialSum);
    }

    [aicore] inline void PartialKMultiIter(bool enPartialSum)
    {

        SplitParams aL0Params = BASE_MODULE::InitSplitAParams();
        SplitParams bL0Params = BASE_MODULE::InitSplitBParams();
        bool isATranspose = cast_to_MatmulShapeInfo()->IsTransposeA();
        bool isBTranspose = cast_to_MatmulShapeInfo()->IsTransposeB();


        int32_t curKaOuterIdx = cast_to_KLoop()->GetOuterKaIdx();
        int32_t curKbOuterIdx = cast_to_KLoop()->GetOuterKbIdx();


        LocalTensor<TransAT> a1;
        LocalTensor<TransBT> b1;
        BASE_MODULE::CopyIn(a1, b1);
        LocalTensor<BiasT> bias = BASE_MODULE::SplitBias(bL0Params.axisL0Len);
        Compute(a1, b1, bias, enPartialSum, isATranspose, isBTranspose, aL0Params, bL0Params);

        BASE_MODULE::DoPreloadAWait();
        BASE_MODULE::ClearL1BufferCache(curKaOuterIdx, curKbOuterIdx);
        BASE_MODULE::ResetCopyInBuffer();
    }

    [aicore] inline void Compute(const LocalTensor<TransAT>& a1, const LocalTensor<TransBT>& b1, LocalTensor<BiasT>& bias,
        const bool enPartialSum, const bool isATranspose, const bool isBTranspose, SplitParams& aL0Params, SplitParams& bL0Params)
    {

        bool sL0CInit = false;
        bool sL0CLast = false;
        BASE_MODULE::SplitPrepare(enPartialSum, isATranspose, isBTranspose, aL0Params, bL0Params, sL0CInit, sL0CLast);

        int32_t kL1Stride = cast_to_KLoop()->GetBaseBlockShape() * BASE_MODULE::c0Size_;
        aL0Params.kAxisL1Offset += cast_to_KLoop()->GetStepInnerIdx() * kL1Stride;
        bL0Params.kAxisL1Offset += cast_to_KLoop()->GetStepInnerIdx() * kL1Stride;
        ComputeKDB(a1, b1, aL0Params, bL0Params, isATranspose, isBTranspose, sL0CInit, sL0CLast);
    }

    [aicore] inline void ComputeKDB(const LocalTensor<TransAT>& a1, const LocalTensor<TransBT>& b1,
        const SplitParams& aL0Params, const SplitParams& bL0Params,
        const bool isATranspose, const bool isBTranspose, const bool sL0CInit, const bool sL0CLast)
    {
        cast_to_TBufPoolL0()->Allocate();
        LocalTensor<TransAT> a2 = BASE_MODULE::SplitA(a1, aL0Params, isATranspose);
        LocalTensor<TransBT> b2 = BASE_MODULE::SplitB(b1, bL0Params, isBTranspose);
        cast_to_TBufPoolL0()->EnQue();
        cast_to_TBufPoolL0()->DeQue();
        BASE_MODULE::CubeCompute(cast_to_CubeOutBuffer()->GetTensor(), a2, b2, aL0Params.axisL0Len,
            bL0Params.axisL0Len, cast_to_KLoop()->GetBaseShape(), isATranspose, isBTranspose, sL0CInit, sL0CLast);
        cast_to_TBufPoolL0()->Free();
        cast_to_BiasScheduler()->Free();
    }
};
}
}
