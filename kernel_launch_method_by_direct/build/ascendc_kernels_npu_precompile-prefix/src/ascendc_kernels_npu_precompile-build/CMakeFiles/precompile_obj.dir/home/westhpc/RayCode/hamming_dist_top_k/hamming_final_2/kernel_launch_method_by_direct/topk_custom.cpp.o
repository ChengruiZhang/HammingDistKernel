     [aicore] constexpr int32_t GetCopyHeight(int32_t i)
     {
         return cast_to_MLoop()->GetTileShapeOf(cast_to_MLoop()->GetOuterIdx() + i);
     }

     template <bool IS_TRANS = false>
     [aicore] constexpr int32_t GetCopyWidth(int32_t i, int32_t baseWidth)
     {
         if constexpr (IS_TRANS) {
             return cast_to_MLoop()->GetTileShapeOf(cast_to_MLoop()->GetOuterIdx() + i);
         } else {
             return cast_to_KLoop()->GetTileShapeAOf(cast_to_KLoop()->GetOuterKaIdx() + i);
         }
     }

     [aicore] constexpr bool IsBufferPosEnd(int32_t i)
     {
         return cast_to_MLoop()->GetOuterIdx() + i >= cast_to_MLoop()->GetOuterIter();
     }

     [aicore] constexpr bool IsBufferPosEnd()
     {
         return cast_to_MLoop()->GetOuterIdx() == cast_to_MLoop()->GetOuterIter() - 1;
     }

     [aicore] constexpr bool IsBufferKPosEnd(int32_t i)
     {
         auto tiling = cast_to_MatmulShapeTiling()->GetTiling();
         int32_t stepKaIter =
             Ceil(cast_to_MatmulShapeInfo()->GetSingleCoreK(), tiling.GetBaseK() * tiling.GetStepKa());
         return cast_to_KLoop()->GetOuterKaIdx() + i >= stepKaIter;
     }

     [aicore] constexpr bool IsBufferKPosEnd()
     {
         auto tiling = cast_to_MatmulShapeTiling()->GetTiling();
         int32_t stepKaIter =
             Ceil(cast_to_MatmulShapeInfo()->GetSingleCoreK(), tiling.GetBaseK() * tiling.GetStepKa());
         return cast_to_KLoop()->GetOuterKaIdx() == stepKaIter - 1;
     }

