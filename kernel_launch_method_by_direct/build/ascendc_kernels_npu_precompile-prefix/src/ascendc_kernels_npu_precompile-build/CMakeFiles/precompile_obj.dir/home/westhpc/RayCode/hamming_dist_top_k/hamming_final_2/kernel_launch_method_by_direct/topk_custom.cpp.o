namespace Impl {
namespace Detail {
constexpr int32_t ENVEC_UBUNREUSE_COEFF = 2;
constexpr int32_t ENVEC_NZ2ND_COEFF = 3;
constexpr int32_t ENABLE_TRANS_COEFF = 2;
constexpr int32_t UNABLE_TRANS_COEFF = 4;
template <typename IMPL, class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE,
    const auto& MM_CFG, typename = void>
class MatmulLocalWorkspace {
    using SrcT = typename A_TYPE::T;
    using DstT = typename C_TYPE::T;
    using BiasT = typename BIAS_TYPE::T;

    [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeTiling() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulShapeTiling> (*(static_cast<typename IMPL::MatmulShapeTiling*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulShapeTiling*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeTiling() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulShapeTiling> (*(static_cast<const typename IMPL::MatmulShapeTiling*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulShapeTiling*>(static_cast<const IMPL*>(this))); } };

public:
    [aicore] inline MatmulLocalWorkspace() {}
    [aicore] inline ~MatmulLocalWorkspace() {}






    [aicore] inline void Init(const LocalTensor<uint8_t>& localBuffer)
    {




                                                                                                          ;

    }






    [aicore] inline LocalTensor<uint8_t> GetND2NZWorkspace(int32_t offset = 0) const
    {

                                                                                             ;
        return localWorkspace_[offset];
    }





    [aicore] inline LocalTensor<uint8_t> GetNZ2NDWorkspace() const
    {

                                                                                             ;
        if constexpr (!ToMatmulConfig(MM_CFG).enableUBReuse) {
            return localWorkspace_[cast_to_MatmulShapeTiling()->GetTiling().GetTransLength() * ENVEC_NZ2ND_COEFF];
        } else {
            return localWorkspace_[cast_to_MatmulShapeTiling()->GetTiling().GetTransLength()];
        }
    }





    [aicore] inline LocalTensor<uint8_t> GetCopy2Co2Workspace() const
    {

                                                                                             ;
        if constexpr (!ToMatmulConfig(MM_CFG).enableUBReuse) {
            return localWorkspace_[cast_to_MatmulShapeTiling()->GetTiling().GetTransLength() * ENVEC_UBUNREUSE_COEFF];
        } else {
            return localWorkspace_[0];
        }
    }







    template <bool enableUBReuse = true>
    [aicore] inline LocalTensor<uint8_t> GetWorkspaceWithOffset(int32_t offset = 0) const
    {

                                                                                             ;
        if constexpr (!enableUBReuse) {
            return localWorkspace_[cast_to_MatmulShapeTiling()->GetTiling().GetTransLength() * ENVEC_UBUNREUSE_COEFF + offset];
        } else {
            return localWorkspace_[offset];
        }
    }





    [aicore] inline LocalTensor<DstT> GetTempWorkspace()
    {
        LocalTensor<DstT> localWorkspace = GetCopy2Co2Workspace().template ReinterpretCast<DstT>();
        localWorkspace.SetSize(cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() *
            cast_to_MatmulShapeTiling()->GetTiling().GetBaseN());
        return localWorkspace;
    }

private:
    [aicore] inline void SetWorkspace(const LocalTensor<uint8_t>& localBuffer)
    {
        localWorkspace_ = localBuffer;
        __attribute__((cce_unif_buff)) uint8_t *addr = (__attribute__((cce_unif_buff)) uint8_t *)localBuffer.GetPhyAddr();
                                                                                                   ;

        int32_t totalTransLen = 0;
        if constexpr (A_TYPE::format == CubeFormat::ND || B_TYPE::format == CubeFormat::ND || !PhyPosIsUB(C_TYPE::pos)) {
            if constexpr (ToMatmulConfig(MM_CFG).enableUBReuse) {
                totalTransLen = cast_to_MatmulShapeTiling()->GetTiling().GetTransLength() * ENABLE_TRANS_COEFF;
            } else {
                totalTransLen = cast_to_MatmulShapeTiling()->GetTiling().GetTransLength() * UNABLE_TRANS_COEFF;
            }
        }

        int32_t biasLen = 0;
        if (cast_to_MatmulShapeTiling()->GetTiling().IsBias() && BIAS_TYPE::pos != TPosition::VECCALC) {
            biasLen = cast_to_MatmulShapeTiling()->GetTiling().GetBaseN() * sizeof(BiasT);
        }

                                                                                            ;
    }

private:
    LocalTensor<uint8_t> localWorkspace_;
};

template <typename IMPL, class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE,
    const auto& MM_CFG>
class MatmulLocalWorkspace<IMPL, A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG,
    enable_if_t<!ToMatmulConfig(MM_CFG).enVecND2NZ>> {
    using SrcT = typename A_TYPE::T;
    using DstT = typename C_TYPE::T;
    using BiasT = typename BIAS_TYPE::T;

    [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeTiling() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulShapeTiling> (*(static_cast<typename IMPL::MatmulShapeTiling*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulShapeTiling*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeTiling() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulShapeTiling> (*(static_cast<const typename IMPL::MatmulShapeTiling*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulShapeTiling*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeInfo() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulShapeInfo> (*(static_cast<typename IMPL::MatmulShapeInfo*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulShapeInfo*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeInfo() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulShapeInfo> (*(static_cast<const typename IMPL::MatmulShapeInfo*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulShapeInfo*>(static_cast<const IMPL*>(this))); } };

