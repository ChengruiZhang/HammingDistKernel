    }
}

template <typename DstT, typename SrcT, const FixpipeConfig &config>
[aicore] inline void FixpipeL0C2L1ImplN(__attribute__((cce_cube_buff)) DstT *dst, __attribute__((cce_cube_c)) SrcT *src, __attribute__((cce_cube_buff)) uint64_t *cbufWorkspace,
    const FixpipeParamsV220 &intriParams, const FixpipeTilingV220 &fixpipeTiling, uint16_t calNSize,
    uint16_t nIterIndex)
